---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { serviceAreas } from '@/data/serviceAreas';
import CTABanner from '@/components/sections/home/CTABanner.astro';

const areaListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Custom Home Builder Service Areas',
  description: 'Saadi Construction Group provides custom home design-build services across Houston and surrounding enclaves in Texas.',
  itemListElement: serviceAreas.map((area, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: area.name,
    url: `https://www.saadiconstructiongroup.com/service-areas/${area.slug}`,
  })),
};
---

<Layout
  title="Houston Neighborhoods & Service Areas | Saadi Construction Group"
  description="Saadi Construction Group is a custom home design-build firm serving Memorial, River Oaks, West University Place, The Woodlands, Katy, Sugar Land, and Greater Houston."
  keywords="custom home builder Houston, custom home builder Memorial, custom home builder River Oaks, custom home builder The Woodlands"
  canonicalUrl="https://www.saadiconstructiongroup.com/service-areas"
  pageType="CollectionPage"
  ogImage="/images/p4-exterior-aerial.png"
  ogImageAlt="Aerial view of luxury custom residence in Houston TX"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Service Areas', href: '/service-areas' },
  ]}
  jsonLd={areaListSchema}
>
  <!-- Hero -->
  <section class="relative min-h-[54vh] flex items-end bg-[#1c1917] text-[#fffdf8] pt-36 pb-16 overflow-hidden">
    <img
      src="/images/p4-exterior-aerial.png"
      alt="Aerial view of luxury custom residence in Houston TX"
      class="absolute inset-0 h-full w-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/75 to-[#1c1917]/40"></div>
    <div class="relative z-10 container-main">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-[#dfc8a7]"></span>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7]">
            Greater Houston Jurisdictions
          </p>
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-medium text-[#fffdf8] leading-[1.05]">
          Custom Home Design-Build Across Houston &amp; Surrounding Enclaves
        </h1>
        <p class="mt-5 font-sans text-base md:text-lg text-[#dfd7ca]/85 max-w-2xl leading-relaxed">
          Site-specific soil engineering, municipal permitting, deed restriction navigation, and ground-up residential construction across Harris, Fort Bend, Montgomery, Brazoria, and Galveston counties.
        </p>
      </div>
    </div>
  </section>

  <!-- Areas Grid -->
  <section class="py-20 md:py-28 bg-[#fbf9f5]">
    <div class="container-main">
      <div class="mb-12 max-w-3xl">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-3">
          Municipalities &amp; Enclaves
        </p>
        <h2 class="font-heading text-3xl md:text-5xl font-medium text-[#1c1917]">
          Select your community to review local permitting and building capabilities.
        </h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {serviceAreas.map((area) => (
          <a
            href={`/service-areas/${area.slug}`}
            class="group flex flex-col justify-between border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-7 transition-colors hover:border-[#8c6d46] hover:bg-white"
          >
            <div>
              {area.county && (
                <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.22em] text-[#8c6d46] mb-2">
                  {area.county} County
                </p>
              )}
              <h3 class="font-heading text-2xl md:text-3xl font-medium text-[#1c1917] group-hover:text-[#8c6d46] transition-colors">
                {area.name}
              </h3>
            </div>
            <div class="mt-6 pt-4 border-t border-[rgba(28,25,23,0.08)] flex items-center justify-between">
              <span class="font-sans text-[11px] font-semibold uppercase tracking-[0.18em] text-[#8c6d46] group-hover:text-[#1c1917]">
                Local Building Brief
              </span>
              <span class="text-[#8c6d46] group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
