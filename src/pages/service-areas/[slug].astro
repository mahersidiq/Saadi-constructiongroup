---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import AreaHero from '@/components/sections/service-areas/AreaHero.astro';
import AreaServices from '@/components/sections/service-areas/AreaServices.astro';
import NearbyAreas from '@/components/sections/service-areas/NearbyAreas.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';
import { serviceAreas } from '@/data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = serviceAreas.find((a) => a.slug === slug);
if (!area) return Astro.redirect('/404');

let nearbyAreas = [];
if (area.nearbyAreas && area.nearbyAreas.length > 0) {
  nearbyAreas = area.nearbyAreas
    .map((s) => serviceAreas.find((a) => a.slug === s))
    .filter(Boolean);
} else {
  nearbyAreas = serviceAreas.filter((a) => a.slug !== slug).slice(0, 5);
}

const canonical = `https://www.saadiconstructiongroup.com/service-areas/${area.slug}`;

const localServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: `Custom Home Builder & Design-Build in ${area.name}, TX`,
  serviceType: 'Luxury Custom Home Design-Build & General Contracting',
  description: area.metaDescription || `Custom home builder serving ${area.name}, TX.`,
  url: canonical,
  provider: {
    '@type': 'GeneralContractor',
    '@id': 'https://www.saadiconstructiongroup.com/#organization',
    name: 'Saadi Construction Group',
    telephone: '+18323603804',
    url: 'https://www.saadiconstructiongroup.com',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `${area.name}, TX`,
    containedInPlace: { '@type': 'State', name: 'Texas' },
  },
};

const areaFaqs = area.faqs && area.faqs.length > 0 ? area.faqs : [
  { question: `Do you build custom homes in ${area.name}?`, answer: `Yes. Saadi Construction Group serves ${area.name} homeowners with custom home design-build, architectural plans, structural engineering, permitting, and full construction coordination.` },
  { question: `Can you help evaluate a lot in ${area.name}?`, answer: 'Yes. We review practical feasibility items such as setbacks, utilities, drainage, floodplain considerations, access, easements, soil and foundation planning, and permitting path before construction planning moves forward.' },
  { question: `Do you handle plans and permits for ${area.name} projects?`, answer: 'Yes. We coordinate architectural plans, structural engineering, permit packages, city or county submission, review comments, and construction inspections as part of our single-contract design-build process.' },
];

const areaResourceLinks = [
  { href: '/services/custom-home-design-build', anchor: `${area.name} custom home design-build` },
  { href: '/services/plans-permits-engineering', anchor: 'plans, permits, and engineering' },
  { href: '/blog/houston-permitting-process-custom-homes', anchor: 'Houston permitting guide' },
  { href: '/tools/lot-feasibility-checklist', anchor: 'lot feasibility checklist' },
  { href: '/projects', anchor: 'custom home portfolio' },
  { href: '/contact', anchor: 'schedule a consultation' },
];
---

<Layout
  title={area.metaTitle || `Custom Home Builder ${area.name} TX | Saadi Construction Group`}
  description={area.metaDescription || `Custom home builder serving ${area.name}, Texas. Plans, engineering, permits, and full custom home construction under one contract.`}
  keywords={`custom home builder ${area.name} TX, ${area.name} luxury custom home builder, design-build contractor ${area.name}, build on your lot ${area.name}`}
  canonicalUrl={canonical}
  ogImage="/images/p4-exterior-aerial.png"
  ogImageAlt={`Custom Home Builder in ${area.name}, TX — Saadi Construction Group`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Service Areas', href: '/service-areas' },
    { name: area.name, href: `/service-areas/${area.slug}` },
  ]}
  faqs={areaFaqs}
  speakableSelectors={['h1', '.local-aeo-summary', 'details summary', 'details p']}
  jsonLd={localServiceSchema}
>
  <AreaHero name={area.name} county={area.county} headline={`Custom Home Builder in ${area.name}, TX`} />

  {area.localContent && (
    <section class="bg-[#fbf9f5] py-16 border-b border-[rgba(28,25,23,0.08)]">
      <div class="container-main max-w-4xl">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-3">
          Local Site, Soil &amp; Permitting Context — {area.name}, TX
        </p>
        <p class="local-aeo-summary font-sans text-base md:text-lg text-[#1c1917]/80 leading-8">{area.localContent}</p>
      </div>
    </section>
  )}

  <AreaServices name={area.name} />

  <section class="py-16 bg-[#f6f3ec] border-y border-[rgba(28,25,23,0.08)]">
    <div class="container-main max-w-4xl">
      <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
        Local Planning Resources
      </p>
      <h2 class="font-heading text-3xl font-medium text-[#1c1917] mb-5">
        Essential references for building in {area.name}.
      </h2>
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-[#1c1917]/75">
        {areaResourceLinks.map((link, idx) => (
          <>
            <a href={link.href} class="hover:text-[#8c6d46] transition-colors">{link.anchor}</a>
            {idx < areaResourceLinks.length - 1 && <span aria-hidden="true" class="text-[#8c6d46]">·</span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-[#fbf9f5]">
    <div class="container-main max-w-4xl">
      <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
        Municipality Advisory
      </p>
      <h2 class="font-heading text-3xl md:text-4xl font-medium text-[#1c1917] mb-8">
        {area.name} Custom Home FAQs
      </h2>
      <div class="divide-y divide-[rgba(28,25,23,0.1)] border-y border-[rgba(28,25,23,0.1)]">
        {areaFaqs.map((faq) => (
          <details class="group py-6 cursor-pointer">
            <summary class="flex items-center justify-between gap-4 list-none font-heading font-medium text-xl text-[#1c1917] group-open:text-[#8c6d46]">
              {faq.question}
              <span class="font-sans text-xl text-[#8c6d46] transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 font-sans text-sm text-[#1c1917]/75 leading-7">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <NearbyAreas nearbyAreas={nearbyAreas} />
  <CTABanner />
</Layout>
