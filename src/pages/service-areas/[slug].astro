---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import AreaHero from '@/components/sections/service-areas/AreaHero.astro';
import AreaServices from '@/components/sections/service-areas/AreaServices.astro';
import NearbyAreas from '@/components/sections/service-areas/NearbyAreas.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';
import { serviceAreas } from '@/data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = serviceAreas.find((a) => a.slug === slug);
if (!area) return Astro.redirect('/404');

let nearbyAreas = [];
if (area.nearbyAreas && area.nearbyAreas.length > 0) {
  nearbyAreas = area.nearbyAreas
    .map((s) => serviceAreas.find((a) => a.slug === s))
    .filter(Boolean);
} else {
  nearbyAreas = serviceAreas.filter((a) => a.slug !== slug).slice(0, 5);
}

const canonical = `https://www.saadiconstructiongroup.com/service-areas/${area.slug}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: 'Saadi Construction Group',
  description: area.metaDescription || `Custom home builder serving ${area.name}, TX.`,
  url: canonical,
  telephone: '(281) 625-5350',
  email: 'info@saadiconstructiongroup.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '801 Travis St Suite 2101',
    addressLocality: 'Houston',
    addressRegion: 'TX',
    postalCode: '77002',
    addressCountry: 'US',
  },
  areaServed: { '@type': 'City', name: area.name, containedInPlace: { '@type': 'State', name: 'Texas' } },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.saadiconstructiongroup.com/service-areas' },
    { '@type': 'ListItem', position: 3, name: area.name, item: canonical },
  ],
};

const areaFaqs = area.faqs && area.faqs.length > 0 ? area.faqs : [
  { question: `Do you build custom homes in ${area.name}?`, answer: `Yes. Saadi Construction Group serves ${area.name} homeowners with custom home design-build, plans, structural engineering, permitting, and full construction coordination.` },
  { question: `Can you help evaluate a lot in ${area.name}?`, answer: 'Yes. We review practical feasibility items such as setbacks, utilities, drainage, floodplain considerations, access, easements, soil and foundation planning, and permitting path before construction planning moves forward.' },
  { question: `Do you handle plans and permits for ${area.name} projects?`, answer: 'Yes. We coordinate architectural plans, structural engineering, permit packages, city or county submission, review comments, and construction inspections as part of the design-build process.' },
];

const areaResourceLinks = [
  { href: '/services/custom-home-design-build', anchor: `${area.name} custom home design-build` },
  { href: '/services/plans-permits-engineering', anchor: 'plans, permits, and engineering' },
  { href: '/blog/houston-permitting-process-custom-homes', anchor: 'Houston permitting guide' },
  { href: '/tools/lot-feasibility-checklist', anchor: 'lot feasibility checklist' },
  { href: '/projects', anchor: 'custom home portfolio' },
  { href: '/contact', anchor: 'schedule a consultation' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const jsonLd = [localBusinessSchema, breadcrumbSchema, faqSchema];
---

<Layout
  title={area.metaTitle || `Custom Home Builder ${area.name} TX | Saadi Construction Group`}
  description={area.metaDescription || `Custom home builder serving ${area.name}, Texas. Plans, engineering, permits, and full custom home construction under one contract.`}
  keywords={`custom home builder ${area.name}, ${area.name} TX home construction, design-build ${area.name}`}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <AreaHero name={area.name} county={area.county} headline={`Custom Home Builder in ${area.name} TX`} />
  {area.localContent && (
    <section class="bg-[#fffaf2] py-12">
      <div class="container-main px-4 max-w-3xl">
        <p class="text-lg text-[#17140f]/74 leading-relaxed">{area.localContent}</p>
      </div>
    </section>
  )}
  <AreaServices name={area.name} />
  <section class="py-16 bg-[#eee5d8] border-y border-[rgba(71,57,40,.16)]">
    <div class="container-main px-4 max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-[#b88a4a] mb-3">Local Planning Resources</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-[#17140f] mb-6">Helpful links for building in {area.name}.</h2>
      <div class="flex flex-wrap gap-3">
        {areaResourceLinks.map((link) => (
          <a href={link.href} class="inline-block px-4 py-2 rounded-full bg-[#fffaf2] border border-[rgba(71,57,40,.24)] text-sm font-medium text-[#17140f] hover:border-[#b88a4a] hover:text-[#b88a4a] transition-colors duration-200">{link.anchor}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-[#fffaf2]">
    <div class="container-main px-4 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-[#17140f] mb-8">{area.name} Custom Home FAQs</h2>
      <div class="divide-y divide-[rgba(71,57,40,.16)]">
        {areaFaqs.map((faq) => (
          <details class="group py-6 cursor-pointer">
            <summary class="flex items-center justify-between gap-4 list-none font-heading font-semibold text-lg text-[#17140f]">
              {faq.question}
              <svg class="h-5 w-5 flex-shrink-0 text-[#b88a4a] transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-[#17140f]/74 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <NearbyAreas nearbyAreas={nearbyAreas} />
  <CTABanner />
</Layout>
