---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';
import { publishedBlogPosts } from '@/data/blogPosts';

export function getStaticPaths() {
  return publishedBlogPosts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = publishedBlogPosts.find((p) => p.slug === slug);
if (!post) return Astro.redirect('/404');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `https://www.saadiconstructiongroup.com/blog/${post.slug}#article`,
  headline: post.title,
  description: post.metaDescription,
  author: [
    {
      '@type': 'Person',
      '@id': 'https://www.saadiconstructiongroup.com/#founder',
      name: 'Maher Sidiq',
      jobTitle: 'Principal & Master Builder',
      url: 'https://www.saadiconstructiongroup.com/about',
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.saadiconstructiongroup.com/#organization',
      name: 'Saadi Construction Group',
      url: 'https://www.saadiconstructiongroup.com',
    },
  ],
  publisher: {
    '@type': 'Organization',
    '@id': 'https://www.saadiconstructiongroup.com/#organization',
    name: 'Saadi Construction Group',
    url: 'https://www.saadiconstructiongroup.com',
    logo: { '@type': 'ImageObject', url: 'https://www.saadiconstructiongroup.com/images/saadi-logo-horizontal.svg' },
  },
  about: {
    '@type': 'Thing',
    name: `${post.category} — Custom Home Construction in Houston, TX`,
  },
  datePublished: post.publishDate,
  dateModified: post.publishDate,
  image: `https://www.saadiconstructiongroup.com${post.heroImage}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://www.saadiconstructiongroup.com/blog/${post.slug}` },
};

const relatedArticles = publishedBlogPosts
  .filter((candidate) => candidate.slug !== post.slug && candidate.category === post.category)
  .concat(publishedBlogPosts.filter((candidate) => candidate.slug !== post.slug && candidate.category !== post.category))
  .slice(0, 3);
---

<Layout
  title={post.metaTitle}
  description={post.metaDescription}
  keywords={post.keywords}
  canonicalUrl={`https://www.saadiconstructiongroup.com/blog/${post.slug}`}
  ogType="article"
  ogImage={post.heroImage}
  ogImageAlt={post.heroImageAlt || post.title}
  articleMeta={{
    publishedTime: post.publishDate,
    modifiedTime: post.publishDate,
    author: 'Maher Sidiq — Saadi Construction Group',
    section: post.category,
  }}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/blog' },
    { name: post.title, href: `/blog/${post.slug}` },
  ]}
  faqs={post.faqs || []}
  speakableSelectors={['article h1', '.aeo-article-summary', 'article h2', 'details summary', 'details p']}
  jsonLd={articleSchema}
>
  <!-- Editorial Monograph Header -->
  <section class="bg-[#1c1917] text-[#fffdf8] pt-36 pb-16 border-b border-[rgba(255,253,248,0.08)]">
    <div class="container-main">
      <div class="max-w-3xl">
        <nav class="mb-6 font-sans text-xs uppercase tracking-[0.18em] text-[#dfd7ca]/60" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#dfc8a7]">Home</a>
          <span class="mx-2">/</span>
          <a href="/blog" class="hover:text-[#dfc8a7]">Guides</a>
          <span class="mx-2">/</span>
          <span class="text-[#dfc8a7]">{post.category}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-5 font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#dfc8a7]">
          <span>{post.category}</span>
          <span aria-hidden="true">·</span>
          <span class="text-[#dfd7ca]/75">{post.readTime}</span>
          <span aria-hidden="true">·</span>
          <time class="text-[#dfd7ca]/75 tabular-nums" datetime={post.publishDate}>
            {new Date(post.publishDate + 'T00:00:00').toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>

        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-medium text-[#fffdf8] leading-[1.06]">
          {post.title}
        </h1>
        <p class="mt-5 font-sans text-base md:text-lg text-[#dfd7ca]/85 leading-relaxed max-w-2xl">
          {post.excerpt}
        </p>
      </div>
    </div>
  </section>

  <!-- Hero Image -->
  {post.heroImage && (
    <div class="w-full bg-[#1c1917] pb-12">
      <div class="container-main">
        <img
          src={post.heroImage}
          alt={post.heroImageAlt}
          class="w-full max-h-[520px] object-cover border border-[rgba(255,253,248,0.1)]"
          loading="eager"
        />
      </div>
    </div>
  )}

  <!-- Article Body -->
  <article class="py-20 md:py-28 bg-[#fbf9f5]">
    <div class="container-main">
      <div class="max-w-3xl mx-auto">
        <!-- AEO Direct Answer / Executive Summary Box -->
        <div class="aeo-article-summary mb-12 border-l-2 border-[#8c6d46] bg-[#f6f3ec] p-6 md:p-8">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8c6d46] mb-2">
            Houston Builder Direct Answer · 2026 Engineering Brief
          </p>
          <p class="font-sans text-base text-[#1c1917]/90 leading-7">
            <strong>Key Takeaway:</strong> {post.excerpt} Reviewed by <strong>Maher Sidiq</strong>, Principal &amp; Master Builder at Saadi Construction Group (Houston, TX).
          </p>
        </div>
        {post.sections.map((section) => (
          <div class="mb-12">
            {section.heading && (
              <h2 class="font-heading text-3xl md:text-4xl font-medium text-[#1c1917] mb-5 leading-[1.12]">
                {section.heading}
              </h2>
            )}
            {section.body && section.body.map((para) => (
              <p class="font-sans text-base md:text-lg text-[#1c1917]/80 leading-8 mb-5">{para}</p>
            ))}
            {section.table && (
              <div class="overflow-x-auto my-8 border border-[rgba(28,25,23,0.12)]">
                <table class="w-full font-sans text-sm">
                  <thead>
                    <tr class="bg-[#1c1917] text-[#fffdf8]">
                      <th class="text-left px-5 py-3.5 font-semibold uppercase tracking-[0.14em] text-xs">Scope Item</th>
                      <th class="text-left px-5 py-3.5 font-semibold uppercase tracking-[0.14em] text-xs">Estimated Range</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[rgba(28,25,23,0.08)]">
                    {section.table.map((row, i) => (
                      <tr class={i % 2 === 0 ? 'bg-[#fbf9f5]' : 'bg-[#f6f3ec]'}>
                        <td class="px-5 py-3.5 text-[#1c1917]">{row.scope}</td>
                        <td class="px-5 py-3.5 font-semibold text-[#8c6d46] tabular-nums">{row.costRange}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.list && (
              <ul class="my-6 space-y-3 border-l-2 border-[#8c6d46] pl-6">
                {section.list.map((item) => (
                  <li class="font-sans text-base text-[#1c1917]/80 leading-7">
                    {item}
                  </li>
                ))}
              </ul>
            )}
            {section.footer && (
              <p class="mt-5 font-sans text-sm text-[#1c1917]/70 italic border-l-2 border-[#8c6d46] bg-[#f6f3ec] p-5 leading-7">
                {section.footer}
              </p>
            )}
          </div>
        ))}

        <!-- Internal Links (Zero-Pill Unboxed Typographic Links) -->
        {post.relatedLinks && post.relatedLinks.length > 0 && (
          <div class="my-12 bg-[#f6f3ec] p-7 border border-[rgba(28,25,23,0.1)]">
            <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8c6d46] mb-3">
              Connected Practice Resources
            </p>
            <div class="flex flex-wrap items-center gap-y-2 gap-x-4 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-[#1c1917]/80">
              {post.relatedLinks.map((link, idx) => (
                <>
                  <a href={link.href} class="hover:text-[#8c6d46] transition-colors">
                    {link.anchor}
                  </a>
                  {idx < post.relatedLinks.length - 1 && <span aria-hidden="true" class="text-[#8c6d46]">·</span>}
                </>
              ))}
            </div>
          </div>
        )}

        <!-- FAQs -->
        {post.faqs && post.faqs.length > 0 && (
          <div class="mt-16">
            <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
              Technical Clarifications
            </p>
            <h2 class="font-heading text-3xl md:text-4xl font-medium text-[#1c1917] mb-6">
              Frequently Asked Questions
            </h2>
            <div class="divide-y divide-[rgba(28,25,23,0.1)] border-y border-[rgba(28,25,23,0.1)]">
              {post.faqs.map((faq) => (
                <details class="group py-6 cursor-pointer">
                  <summary class="flex items-center justify-between gap-4 list-none font-heading font-medium text-xl text-[#1c1917] group-open:text-[#8c6d46]">
                    {faq.question}
                    <span class="font-sans text-xl text-[#8c6d46] transition-transform duration-200 group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-4 font-sans text-sm text-[#1c1917]/75 leading-7">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <div class="mt-16 pt-10 border-t border-[rgba(28,25,23,0.1)]">
            <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
              Further Reading
            </p>
            <h2 class="font-heading text-3xl font-medium text-[#1c1917] mb-6">Related Monographs</h2>
            <div class="grid gap-5 md:grid-cols-3">
              {relatedArticles.map((article) => (
                <a
                  href={`/blog/${article.slug}`}
                  class="block border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-6 hover:border-[#8c6d46] hover:bg-white transition-colors"
                >
                  <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8c6d46] mb-2">
                    {article.category}
                  </p>
                  <h3 class="font-heading text-xl font-medium text-[#1c1917] leading-snug">
                    {article.title}
                  </h3>
                  <p class="mt-4 font-sans text-xs text-[#1c1917]/60">{article.readTime}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Author / E-E-A-T Signal -->
        <div class="mt-14 pt-8 border-t border-[rgba(28,25,23,0.1)] flex items-start gap-5">
          <div class="flex-shrink-0 h-12 w-12 bg-[#1c1917] flex items-center justify-center font-heading text-xl text-[#dfc8a7]">
            SCG
          </div>
          <div>
            <p class="font-heading text-xl font-medium text-[#1c1917]">{post.author} — Pre-Construction &amp; Engineering Advisory</p>
            <p class="font-sans text-sm text-[#1c1917]/70 mt-1 leading-6">
              Houston-based single-contract custom home builder specializing in architectural drafting, post-tension slab engineering, municipal permitting, and turnkey residential construction across Memorial, River Oaks, West University Place, and The Woodlands.{' '}
              <a href="/about" class="text-[#8c6d46] font-medium hover:underline">Examine our practice →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <CTABanner />
</Layout>
