---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { publishedBlogPosts } from '@/data/blogPosts';
import CTABanner from '@/components/sections/home/CTABanner.astro';

const published = publishedBlogPosts
  .slice()
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Houston Custom Home Building Guides & Research',
  description: 'Technical guides on custom home building in Houston — design-build, plans, permits, soil engineering, and construction cost drivers.',
  url: 'https://www.saadiconstructiongroup.com/blog',
  publisher: {
    '@type': 'Organization',
    name: 'Saadi Construction Group',
    url: 'https://www.saadiconstructiongroup.com',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: published.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.title,
      url: `https://www.saadiconstructiongroup.com/blog/${post.slug}`,
    })),
  },
};
---

<Layout
  title="Houston Custom Home Building Guides | Saadi Construction Group"
  description="Technical cost guides, design-build explainers, soil & foundation engineering briefs, and permitting insights for homeowners building across Greater Houston."
  keywords="custom home builder blog Houston, custom home construction insights Houston, design-build guide Houston"
  canonicalUrl="https://www.saadiconstructiongroup.com/blog"
  ogImage="/images/p5-exterior-front.png"
  ogImageAlt="Houston custom home architecture and engineering guides"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/blog' },
  ]}
  jsonLd={collectionSchema}
>
  <!-- Hero -->
  <section class="relative min-h-[52vh] flex items-end bg-[#1c1917] text-[#fffdf8] pt-36 pb-16 overflow-hidden">
    <img
      src="/images/p5-exterior-front.png"
      alt="Houston custom home architecture and engineering guides"
      class="absolute inset-0 h-full w-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/75 to-[#1c1917]/40"></div>
    <div class="relative z-10 container-main">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-[#dfc8a7]"></span>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7]">
            Architectural &amp; Engineering Monographs
          </p>
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-medium text-[#fffdf8] leading-[1.05]">
          Custom Home Building Guides — Houston, TX
        </h1>
        <p class="mt-5 font-sans text-base md:text-lg text-[#dfd7ca]/85 max-w-2xl leading-relaxed">
          2026 per-square-foot cost breakdowns, post-tension foundation engineering briefs, and municipal permitting guides for homeowners building across the Greater Houston metro.
        </p>
      </div>
    </div>
  </section>

  <!-- Post Grid -->
  <section class="py-20 md:py-28 bg-[#fbf9f5]">
    <div class="container-main">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {published.map((post) => (
          <article class="group flex flex-col border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] transition-colors hover:border-[#8c6d46] hover:bg-white">
            {post.heroImage && (
              <a href={`/blog/${post.slug}`} class="image-zoom block aspect-[16/10] border-b border-[rgba(28,25,23,0.08)]">
                <img
                  src={post.heroImage}
                  alt={post.heroImageAlt || post.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </a>
            )}
            <div class="flex flex-col flex-1 p-7">
              <div class="flex items-center gap-2 mb-3 font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8c6d46]">
                <span>{post.category}</span>
                <span aria-hidden="true">·</span>
                <span class="text-[#1c1917]/60">{post.readTime}</span>
              </div>
              <h2 class="font-heading text-2xl md:text-3xl font-medium text-[#1c1917] leading-[1.12] mb-3 group-hover:text-[#8c6d46] transition-colors">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="font-sans text-sm text-[#1c1917]/75 leading-7 flex-1 mb-6">
                {post.excerpt}
              </p>
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-[rgba(28,25,23,0.08)]">
                <time class="font-sans text-xs text-[#1c1917]/55 tabular-nums" datetime={post.publishDate}>
                  {new Date(post.publishDate + 'T00:00:00').toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <a
                  href={`/blog/${post.slug}`}
                  class="font-sans text-[11px] font-semibold uppercase tracking-[0.18em] text-[#8c6d46] group-hover:text-[#1c1917]"
                >
                  Read Monograph →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
