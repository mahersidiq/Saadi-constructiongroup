---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Saadi Construction Group"
  description="The page you are looking for does not exist. Return to the Saadi Construction Group homepage."
  noindex={true}
>
  <section class="min-h-[82vh] flex items-center justify-center bg-[#1c1917] text-[#fffdf8] relative overflow-hidden pt-24">
    <div class="relative z-10 text-center px-5 py-20 max-w-xl mx-auto">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.24em] text-[#dfc8a7] mb-3">
        Error 404
      </p>
      <h1 class="font-heading text-5xl md:text-6xl font-medium text-[#fffdf8]">
        Page Not Found
      </h1>
      <p class="mt-4 font-sans text-base text-[#dfd7ca]/75 leading-relaxed">
        The architectural dossier or page you requested has been moved or does not exist.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center bg-[#8c6d46] px-8 py-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254]"
        >
          Return Home
        </a>
        <a
          href="/projects"
          class="inline-flex items-center justify-center border border-[rgba(255,253,248,0.3)] px-8 py-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:border-[#dfc8a7]"
        >
          Explore Portfolio
        </a>
      </div>
    </div>
  </section>
</Layout>
