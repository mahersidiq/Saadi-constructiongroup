---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
---
<Layout title="About Saadi Construction Group | Houston Custom Home Builder" description="Saadi Construction Group is a Houston custom home builder coordinating plans, engineering, permits, and construction under one accountable contract." keywords="Houston custom home builder, custom home design-build Houston, Saadi Construction Group" canonicalUrl="https://www.saadiconstructiongroup.com/about">
  <section class="relative min-h-[68vh] overflow-hidden bg-[#142232] text-[#fff8ed]"><img src="/images/p1-interior-bath.png" alt="Modern custom home exterior in Houston at dusk" class="absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-[#111d2a]/88 via-[#111d2a]/55 to-transparent"></div><div class="relative container-main flex min-h-[68vh] items-end pb-16 pt-36"><div class="max-w-4xl"><p class="eyebrow">About Saadi</p><h1 class="display-heading mt-4 text-5xl text-[#fff8ed] md:text-7xl">Owner-led accountability from plans to final walkthrough.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-[#fff8ed]/80">Saadi Construction Group is built for homeowners who want the design, permitting, engineering, and construction path controlled by one responsible team.</p></div></div></section>
  <section class="stone-section"><div class="container-main section-padding"><div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr]"><div><p class="eyebrow">Who We Are</p><h2 class="display-heading mt-4 text-4xl md:text-6xl">A Houston builder focused on control, communication, and craft.</h2></div><div class="space-y-6 body-large"><p>Saadi Construction Group operates as a design-build general contractor for custom homes and major residential construction in Greater Houston.</p><p>The model is direct: one contract coordinates architectural plans, structural engineering, permit submission, preconstruction scope, trade coordination, construction, and handoff.</p><p>No fake awards, inflated promises, or stock team story—just a clearer way to manage a serious custom-home build.</p></div></div></div></section>
  <section class="bg-[#fbf6ed]"><div class="container-main pb-24"><div class="grid gap-4 md:grid-cols-3">{['Accountability', 'Houston experience', 'Direct communication'].map((item) => <div class="border border-[rgba(71,57,40,.14)] bg-white/70 p-8"><h3 class="font-heading text-3xl text-[#17202a]">{item}</h3><p class="mt-4 leading-7 text-[#17202a]/70">Construction control starts with clear responsibility, practical field knowledge, and communication that does not get buried between separate vendors.</p></div>)}</div></div></section>
</Layout>
