---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { projects } from '@/data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const canonical = `https://www.saadiconstructiongroup.com/projects/${project.slug}`;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: canonical,
  image: project.images.map((image) => `https://www.saadiconstructiongroup.com${image.src}`),
  creator: { '@type': 'Organization', name: 'Saadi Construction Group', url: 'https://www.saadiconstructiongroup.com' },
  contentLocation: { '@type': 'Place', name: project.location },
  about: project.tags,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: 'https://www.saadiconstructiongroup.com/projects' },
    { '@type': 'ListItem', position: 3, name: project.title, item: canonical },
  ],
};
const details = [
  ['Location / Area', project.location],
  ['Construction Type', project.tags.join(', ')],
  ['Design Intent', project.style],
  ['Known Size', project.sqft],
  ['Materials & Finishes', project.materials],
  ['Construction Timeline', project.timeline],
  ['Site & Design Notes', project.siteNotes],
];
const progressStages = ['Planning', 'Permitting', 'Site prep', 'Foundation', 'Framing', 'MEP rough-in', 'Insulation', 'Drywall', 'Exterior finishes', 'Interior finishes', 'Final walkthrough'];
---
<Layout title={`${project.title} Custom Home in ${project.location} | Saadi Construction Group`} description={`${project.title} — a ${project.sqft} ${project.style.toLowerCase()} custom home built in ${project.location} by Saadi Construction Group. Materials, timeline, and design-build scope.`} canonicalUrl={canonical} jsonLd={[projectSchema, breadcrumbSchema]}>
  <section class="relative min-h-[78vh] overflow-hidden bg-[#2a2018] text-[#fff8ed]">
    <img src={project.coverImage} alt={project.coverAlt} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#171512]/88 via-[#171512]/48 to-transparent"></div>
    <div class="relative container-main flex min-h-[78vh] items-end pb-16 pt-36">
      <div class="max-w-4xl"><p class="eyebrow">{project.style} · {project.location}</p><h1 class="display-heading mt-4 text-5xl text-[#fff8ed] md:text-7xl">{project.title}</h1><p class="mt-5 text-lg text-[#fff8ed]/80">{project.sqft} · {project.tags.join(' · ')}</p></div>
    </div>
  </section>
  <section class="stone-section"><div class="container-main section-padding"><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">Project Summary</p><h2 class="display-heading mt-4 text-4xl md:text-5xl">{project.title} · {project.location}</h2><p class="body-large mt-6">{project.summary}</p><a href="/contact" class="btn-luxe-fill mt-8">Schedule Consultation</a></div><div class="grid gap-4 sm:grid-cols-2">{project.images.map((image, i) => <figure class={i === 0 ? 'sm:col-span-2' : ''}><img src={image.src} alt={image.alt} class="aspect-[4/3] h-full w-full object-cover" loading="lazy" /><figcaption class="mt-2 text-xs uppercase tracking-[0.16em] text-[#6f563f]">{image.type}</figcaption></figure>)}</div></div></div></section>
  <section class="bg-[#fffaf2] py-16 md:py-24">
    <div class="container-main px-4">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
        <div>
          <p class="eyebrow">Case Study</p>
          <h2 class="display-heading mt-4 text-4xl md:text-5xl">Verified project details and construction scope.</h2>
          <p class="body-large mt-6">Materials, timeline, and site conditions for this {project.style.toLowerCase()} custom home in {project.location}. Saadi Construction Group delivered architectural plans, structural engineering, permitting, and full construction under a single design-build contract.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {details.map(([label, value]) => (
            <div class="border border-[rgba(71,57,40,.14)] bg-[#fffaf2] p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#6f563f]">{label}</p>
              <p class="mt-3 text-[#17140f]/75">{value}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-12 border-t border-[rgba(71,57,40,.16)] pt-10">
        <h3 class="font-heading text-3xl text-[#17140f]">Related services</h3>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/services/custom-home-design-build" class="inline-block px-4 py-2 rounded-full bg-[#fffaf2] border border-[rgba(71,57,40,.24)] text-sm font-medium text-[#17140f] hover:border-[#b88a4a] hover:text-[#b88a4a] transition-colors duration-200">custom home design-build</a>
          <a href="/services/new-home-construction" class="inline-block px-4 py-2 rounded-full bg-[#fffaf2] border border-[rgba(71,57,40,.24)] text-sm font-medium text-[#17140f] hover:border-[#b88a4a] hover:text-[#b88a4a] transition-colors duration-200">new home construction</a>
          <a href="/services/plans-permits-engineering" class="inline-block px-4 py-2 rounded-full bg-[#fffaf2] border border-[rgba(71,57,40,.24)] text-sm font-medium text-[#17140f] hover:border-[#b88a4a] hover:text-[#b88a4a] transition-colors duration-200">plans, permits, and engineering</a>
        </div>
      </div>
    </div>
  </section>
  <section class="stone-section">
    <div class="container-main section-padding">
      <p class="eyebrow">Progress Documentation Framework</p>
      <h2 class="display-heading mt-4 text-4xl md:text-5xl">Construction stages ready for verified updates.</h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {progressStages.map((stage) => <div class="border border-[rgba(71,57,40,.14)] bg-[#fffaf2]/70 p-5 text-sm font-medium text-[#17140f]/75">{stage}</div>)}
      </div>
    </div>
  </section>
</Layout>
