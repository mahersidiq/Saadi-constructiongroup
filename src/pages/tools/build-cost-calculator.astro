---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/build-cost-calculator';
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' }] };
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Build Cost Calculator', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, publisher: { '@type': 'Organization', name: 'Saadi Construction Group' } };
---
<Layout title="Build Cost Calculator | Houston Custom Homes" description="Estimate planning ranges for a Houston custom home based on square footage, finish level, stories, site complexity, garage, outdoor living, and design scope." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, softwareSchema]}>
  <section class="relative min-h-[42vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 py-20 md:py-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Build Cost Calculator</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">Estimate a planning range before requesting a detailed proposal. These numbers are not bids and must be verified against plans, engineering, site conditions, and selections.</p>
    </div>
  </section>
  <section class="section-padding bg-white"><div class="container-main px-4 max-w-4xl"><div class="grid gap-6 md:grid-cols-2"><label class="block text-sm font-semibold text-charcoal">Square footage<input id="sqft" type="number" value="3000" class="mt-2 w-full border border-gray-300 p-3" /></label><label class="block text-sm font-semibold text-charcoal">Finish level<select id="finish" class="mt-2 w-full border border-gray-300 p-3"><option value="170">Essential</option><option value="230" selected>Custom</option><option value="325">Luxury</option></select></label><label class="block text-sm font-semibold text-charcoal">Stories<select id="stories" class="mt-2 w-full border border-gray-300 p-3"><option value="1">1 story</option><option value="1.06">2 stories</option><option value="1.12">3 stories</option></select></label><label class="block text-sm font-semibold text-charcoal">Site complexity<select id="site" class="mt-2 w-full border border-gray-300 p-3"><option value="1">Standard</option><option value="1.08">Moderate</option><option value="1.18">Complex drainage/floodplain/access</option></select></label><label class="flex items-center gap-3 text-sm font-semibold text-charcoal"><input id="garage" type="checkbox" checked /> Garage included</label><label class="flex items-center gap-3 text-sm font-semibold text-charcoal"><input id="outdoor" type="checkbox" /> Outdoor living allowance</label><label class="flex items-center gap-3 text-sm font-semibold text-charcoal"><input id="design" type="checkbox" checked /> Design/engineering included</label></div><div class="mt-10 rounded-lg bg-light-gray p-6 border border-gray-200"><h2 class="font-heading text-3xl text-charcoal">Estimated planning range</h2><p id="cost-output" class="mt-4 text-2xl font-bold text-navy"></p><p class="mt-3 text-gray-700">Planning range only. Final pricing requires plans, engineering, site review, permit path, selections, and scope confirmation.</p><ul id="drivers" class="mt-5 list-disc pl-6 text-gray-700 space-y-2"></ul><div class="mt-8 flex flex-wrap gap-3"><a href="/services/custom-home-design-build" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">Houston custom home design-build</a><a href="/services/plans-permits-engineering" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">plans, permits, and engineering</a><a href="/contact" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">schedule a consultation</a></div></div></div></section><script>function calc(){const sqft=Number(document.getElementById('sqft').value||0);const finish=Number(document.getElementById('finish').value);const stories=Number(document.getElementById('stories').value);const site=Number(document.getElementById('site').value);let base=sqft*finish*stories*site;if(document.getElementById('garage').checked)base+=45000;if(document.getElementById('outdoor').checked)base+=55000;if(document.getElementById('design').checked)base+=35000;const low=Math.round(base*.9/1000)*1000;const high=Math.round(base*1.18/1000)*1000;document.getElementById('cost-output').textContent='$'+low.toLocaleString()+' – $'+high.toLocaleString();document.getElementById('drivers').innerHTML=['Finish level and selections','Site complexity, drainage, and floodplain considerations','Foundation, engineering, and number of stories','Garage, outdoor living, design, and permit scope'].map(x=>'<li>'+x+'</li>').join('');}document.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',calc));calc();</script>
</Layout>
