---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/build-cost-calculator';
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
  { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' },
  { '@type': 'ListItem', position: 3, name: 'Build Cost Calculator', item: canonical },
] };
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Build Cost Calculator', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, publisher: { '@type': 'Organization', name: 'Saadi Construction Group' } };
const inputClass = 'mt-2 w-full border border-[rgba(71,57,40,.2)] bg-[#fffaf2] px-4 py-4 text-[#17202a] outline-none focus:border-[#b88a4a]';
---
<Layout title="Build Cost Calculator | Houston Custom Homes" description="Estimate planning ranges for a Houston custom home based on square footage, finish level, stories, site complexity, garage, outdoor living, and design scope." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, softwareSchema]}>
  <section class="relative min-h-[48vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 pt-36 pb-20 md:pt-44 md:pb-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Build Cost Calculator</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">Estimate a planning range before requesting a detailed proposal. Final pricing requires plans, engineering, site review, selections, and scope confirmation.</p>
    </div>
  </section>

  <section class="stone-section">
    <div class="container-main section-padding">
      <div class="grid gap-10 lg:grid-cols-[1fr_0.8fr]">
        <div class="editorial-card p-6 md:p-8">
          <p class="eyebrow">Cost Inputs</p>
          <h2 class="mt-4 font-heading text-4xl text-[#17202a]">Adjust the major cost drivers.</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <label class="block text-sm font-semibold text-[#17202a]">Square footage<input id="sqft" type="number" value="3000" min="500" class={inputClass} /></label>
            <label class="block text-sm font-semibold text-[#17202a]">Finish level<select id="finish" class={inputClass}><option value="170">Essential</option><option value="230" selected>Custom</option><option value="325">Luxury</option></select></label>
            <label class="block text-sm font-semibold text-[#17202a]">Stories<select id="stories" class={inputClass}><option value="1">1 story</option><option value="1.06">2 stories</option><option value="1.12">3 stories</option></select></label>
            <label class="block text-sm font-semibold text-[#17202a]">Site complexity<select id="site" class={inputClass}><option value="1">Standard</option><option value="1.08">Moderate</option><option value="1.18">Complex drainage/floodplain/access</option></select></label>
          </div>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <label class="flex gap-3 border border-[rgba(71,57,40,.14)] bg-[#fffaf2] p-4 text-sm font-semibold text-[#17202a]"><input id="garage" type="checkbox" checked class="mt-1 h-5 w-5 accent-[#b88a4a]" /> Garage included</label>
            <label class="flex gap-3 border border-[rgba(71,57,40,.14)] bg-[#fffaf2] p-4 text-sm font-semibold text-[#17202a]"><input id="outdoor" type="checkbox" class="mt-1 h-5 w-5 accent-[#b88a4a]" /> Outdoor living</label>
            <label class="flex gap-3 border border-[rgba(71,57,40,.14)] bg-[#fffaf2] p-4 text-sm font-semibold text-[#17202a]"><input id="design" type="checkbox" checked class="mt-1 h-5 w-5 accent-[#b88a4a]" /> Design/engineering</label>
          </div>
        </div>

        <aside class="editorial-card p-6 md:p-8 self-start">
          <p class="eyebrow">Planning Range</p>
          <h2 class="mt-4 font-heading text-4xl text-[#17202a]">Estimated cost</h2>
          <p id="cost-output" class="mt-6 text-2xl font-semibold leading-8 text-[#142232]"></p>
          <p class="mt-5 text-sm leading-7 text-[#17202a]/68">This is a planning tool, not a bid. A fixed proposal needs project-specific drawings, engineering, permit path, selections, and site verification.</p>
          <ul id="drivers" class="mt-6 space-y-3 text-sm leading-6 text-[#17202a]/72"></ul>
          <a href="/contact" class="btn-luxe-fill mt-7">Request Project Review</a>
        </aside>
      </div>
    </div>
  </section>
  <script>
    function calc() {
      const sqft = Number(document.getElementById('sqft').value || 0);
      const finish = Number(document.getElementById('finish').value);
      const stories = Number(document.getElementById('stories').value);
      const site = Number(document.getElementById('site').value);
      let base = sqft * finish * stories * site;
      if (document.getElementById('garage').checked) base += 45000;
      if (document.getElementById('outdoor').checked) base += 55000;
      if (document.getElementById('design').checked) base += 35000;
      const low = Math.round(base * 0.9 / 1000) * 1000;
      const high = Math.round(base * 1.18 / 1000) * 1000;
      document.getElementById('cost-output').textContent = '$' + low.toLocaleString() + ' – $' + high.toLocaleString();
      document.getElementById('drivers').innerHTML = ['Finish level and selections', 'Site complexity, drainage, and floodplain considerations', 'Foundation, engineering, and number of stories', 'Garage, outdoor living, design, and permit scope'].map((x) => '<li class="border-l-2 border-[#b88a4a] pl-3">' + x + '</li>').join('');
    }
    document.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', calc));
    calc();
  </script>
</Layout>
