---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/lot-feasibility-checklist';
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' }] };
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Lot Feasibility Checklist', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, publisher: { '@type': 'Organization', name: 'Saadi Construction Group' } };
---
<Layout title="Houston Lot Feasibility Checklist | Custom Homes" description="Interactive Houston lot feasibility checklist for zoning, setbacks, utilities, drainage, floodplain, easements, trees, access, soil, and HOA requirements." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, softwareSchema]}>
  <section class="relative min-h-[42vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 py-20 md:py-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Lot Feasibility Checklist</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">Use this checklist before buying land or starting plans. It highlights common Houston-area feasibility questions that should be verified before pricing construction.</p>
    </div>
  </section>
  <section class="section-padding bg-white"><div class="container-main px-4 max-w-4xl"><div class="grid gap-4 md:grid-cols-2"><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Zoning or deed restrictions</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Setbacks</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Utilities</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Drainage</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Floodplain</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Easements</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Tree restrictions</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Access</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">Soil/foundation considerations</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label><label class="flex gap-3 border border-gray-200 bg-white p-4 text-gray-700"><input type="checkbox" class="mt-1" /> <span><strong class="text-charcoal">HOA restrictions if applicable</strong><br /><span class="text-sm">Verify this before finalizing plans or pricing.</span></span></label></div><p class="mt-8 text-gray-700">Checklist only. Saadi Construction Group can review lot-specific constraints during preconstruction planning.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/services/custom-home-design-build" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">Houston custom home design-build</a><a href="/services/plans-permits-engineering" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">plans, permits, and engineering</a><a href="/contact" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">schedule a consultation</a></div></div></section>
</Layout>
