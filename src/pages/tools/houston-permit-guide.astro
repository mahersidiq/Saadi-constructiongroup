---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/houston-permit-guide';
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' }] };
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Houston Permit Guide', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, publisher: { '@type': 'Organization', name: 'Saadi Construction Group' } };
---
<Layout title="Houston Permit Guide | Custom Home Permitting" description="Step-by-step Houston custom home permit guide covering drawings, engineering, site plans, city or county review, revisions, approvals, and inspections." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, softwareSchema]}>
  <section class="relative min-h-[42vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 py-20 md:py-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Houston Permit Guide</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">Understand the permit sequence before design and construction begin. This guide is educational and does not replace jurisdiction-specific review.</p>
    </div>
  </section>
  <section class="section-padding bg-white"><div class="container-main px-4 max-w-4xl"><div class="space-y-4"><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">1. Drawings</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">2. Engineering</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">3. Site plan</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">4. City/county review</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">5. Revisions</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">6. Approvals</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details><details class="border border-gray-200 p-5"><summary class="font-heading text-xl font-semibold text-charcoal">7. Inspections</summary><p class="mt-3 text-gray-700 leading-relaxed">Prepare, review, or complete this step with the correct jurisdiction before moving forward. Requirements vary by city, county, floodplain status, and scope.</p></details></div><div class="mt-8 flex flex-wrap gap-3"><a href="/services/custom-home-design-build" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">Houston custom home design-build</a><a href="/services/plans-permits-engineering" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">plans, permits, and engineering</a><a href="/contact" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">schedule a consultation</a></div></div></section>
</Layout>
