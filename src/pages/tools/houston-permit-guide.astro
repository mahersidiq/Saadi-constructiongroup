---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';

const canonical = 'https://www.saadiconstructiongroup.com/tools/houston-permit-guide';
const permitSteps = [
  {
    title: 'Confirm the Reviewing Jurisdiction & Deed Restrictions',
    why: 'A Houston mailing address does not always mean the City of Houston is the reviewing authority. Your parcel may fall under the City of Houston, Bellaire, West University Place, Memorial Villages, Harris County, Fort Bend County, Montgomery County, or a strict HOA Architectural Control Committee.',
    items: ['Verify municipal or county authority', 'Audit deed restrictions & HOA/ACC rules', 'Identify Chapter 19 floodplain or detention triggers'],
  },
  {
    title: 'Compile Permit-Ready Architectural & Civil Drawings',
    why: 'Municipal plan examiners require a coordinated construction document package—not conceptual sketches. Missing setback dimensions, impervious cover calculations, or energy code compliance sheets trigger multi-week correction cycles.',
    items: ['Dimensioned floor plans & exterior elevations', 'Boundary survey & civil grading/drainage plan', 'REScheck energy compliance & wall bracing notes'],
  },
  {
    title: 'Seal Geotechnical & Structural Foundation Engineering',
    why: 'Houston’s expansive clay soils (plasticity index 25–45) require site-specific geotechnical borings and PE-sealed post-tensioned slab or pier-supplemented foundation drawings prior to permit submittal.',
    items: ['Geotechnical soil boring report', 'PE-stamped post-tensioned foundation plan', 'Windstorm / structural framing calculations'],
  },
  {
    title: 'Manage Plan Review & Discipline Corrections',
    why: 'Structural, civil, drainage, and utility reviewers examine submittals in parallel. Responding with a unified, cross-referenced revision package prevents conflicting comments and secondary holds.',
    items: ['Complete electronic portal submittal', 'Comment tracking by engineering discipline', 'Coordinated revision resubmittal'],
  },
  {
    title: 'Execute Staged Municipal Field Inspections',
    why: 'Permitting continues throughout field construction. Piers, pre-pour post-tension cables, rough framing, MEP rough-ins, energy insulation, and final occupancy inspections must be sequenced into the critical path.',
    items: ['Pre-pour foundation & cable inspection', 'Frame, sheer wall & MEP rough-in approvals', 'Final Certificate of Occupancy closeout'],
  },
];
const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Houston Custom Home Permit Guide',
  description: 'Step-by-step guide to the Houston custom home permitting path, including drawings, engineering, site plans, review, revisions, approval, inspections, and final closeout.',
  publisher: { '@type': 'Organization', name: 'Saadi Construction Group', url: 'https://www.saadiconstructiongroup.com' },
  step: permitSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.why,
  })),
};
const quickChecks = [
  'Municipal Jurisdiction',
  'Setback & Easement Lines',
  '100/500-Year Floodplain Status',
  'Civil Drainage & Detention',
  'Water/Sewer Tap Capacity',
  'PE Structural & Soil Report',
  'HOA / Deed Restriction Sign-Off',
  'Staged Inspection Sequence',
];
---

<Layout
  title="Houston Permit Guide | Custom Home Permitting | Saadi Construction Group"
  description="Step-by-step Houston custom home permit roadmap covering architectural drawings, structural engineering, site drainage plans, municipal review, and field inspections."
  keywords="Houston custom home permit guide, Houston Permitting Center residential permit, Chapter 19 drainage Houston, custom home building permit Texas"
  canonicalUrl={canonical}
  ogImage="/images/p6-exterior-front.png"
  ogImageAlt="Houston Custom Home Permit Guide — Saadi Construction Group"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Planning Tools', href: '/tools' },
    { name: 'Houston Permit Guide', href: '/tools/houston-permit-guide' },
  ]}
  jsonLd={guideSchema}
>
  <section class="bg-[#1c1917] text-[#fffdf8] pt-36 pb-16 border-b border-[rgba(255,253,248,0.08)]">
    <div class="container-main">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-[#dfc8a7]"></span>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7]">
            Municipal Compliance Roadmap
          </p>
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-medium text-[#fffdf8] leading-[1.05]">
          Houston Custom Home Permit Guide
        </h1>
        <p class="mt-5 font-sans text-base md:text-lg text-[#dfd7ca]/85 max-w-2xl leading-relaxed">
          A technical roadmap for navigating the Houston Permitting Center, surrounding municipalities, and county engineering boards from initial survey to Certificate of Occupancy.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-[#fbf9f5]">
    <div class="container-main">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-7 md:p-8 self-start lg:sticky lg:top-28">
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46]">
            Pre-Submittal Gateways
          </p>
          <h2 class="mt-2 font-heading text-3xl font-medium text-[#1c1917]">
            Submittal Readiness Check
          </h2>
          <div class="mt-6 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1">
            {quickChecks.map((item, idx) => (
              <div class="flex items-center gap-3 border border-[rgba(28,25,23,0.1)] bg-[#fbf9f5] px-4 py-3">
                <span class="font-sans text-xs font-semibold text-[#8c6d46] tabular-nums">
                  0{idx + 1}
                </span>
                <span class="font-sans text-sm font-medium text-[#1c1917]/85">{item}</span>
              </div>
            ))}
          </div>
          <p class="mt-6 font-sans text-xs leading-6 text-[#1c1917]/70">
            Under our single-contract Design-Build delivery, Saadi Construction Group prepares, stamps, submits, and tracks the entire municipal and HOA permit package on your behalf.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-flex w-full items-center justify-center bg-[#8c6d46] px-6 py-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254]"
          >
            Discuss Your Permit Path →
          </a>
        </aside>

        <div class="space-y-6">
          {permitSteps.map((step, index) => (
            <article class="border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-7 md:p-9">
              <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] tabular-nums">
                Phase 0{index + 1}
              </p>
              <h2 class="mt-2 font-heading text-3xl font-medium text-[#1c1917]">{step.title}</h2>
              <p class="mt-3 font-sans text-sm md:text-base leading-7 text-[#1c1917]/75">{step.why}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                {step.items.map((item) => (
                  <li class="border border-[rgba(28,25,23,0.1)] bg-[#fbf9f5] p-4 font-sans text-xs font-medium leading-5 text-[#1c1917]/80">
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
