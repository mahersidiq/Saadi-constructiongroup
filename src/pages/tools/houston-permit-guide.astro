---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/houston-permit-guide';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' },
    { '@type': 'ListItem', position: 3, name: 'Houston Permit Guide', item: canonical },
  ],
};
const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Houston Custom Home Permit Guide',
  description: 'Educational step-by-step guide to the Houston custom home permitting path, including drawings, engineering, site plans, review, revisions, approval, inspections, and final closeout.',
  publisher: { '@type': 'Organization', name: 'Saadi Construction Group' },
  step: [
    'Confirm jurisdiction and property constraints',
    'Prepare architectural drawings and site plan',
    'Coordinate structural engineering and foundation requirements',
    'Submit the permit package for city or county review',
    'Respond to review comments and resubmit revisions',
    'Schedule inspections during construction',
    'Close out final inspections before handoff',
  ],
};
const permitSteps = [
  {
    title: 'Confirm the jurisdiction first',
    why: 'A Houston mailing address does not always mean the City of Houston is the reviewing authority. Your lot may fall under a city, county, utility district, deed restrictions, or an HOA review process.',
    items: ['Confirm city or county authority', 'Check deed restrictions and HOA requirements', 'Identify floodplain or drainage review triggers'],
  },
  {
    title: 'Prepare permit-ready drawings',
    why: 'Permit review usually needs a coordinated drawing package, not a concept sketch. Missing dimensions, code notes, elevations, and site information can lead to correction cycles.',
    items: ['Architectural floor plans and elevations', 'Site plan with setbacks and lot information', 'Construction notes and project scope'],
  },
  {
    title: 'Coordinate engineering before submission',
    why: 'Houston-area soil and drainage conditions make foundation and structural coordination important before permit submission and pricing.',
    items: ['Foundation design assumptions', 'Structural framing requirements', 'Soil report or engineering inputs when required'],
  },
  {
    title: 'Submit and track review comments',
    why: 'Reviewers may request corrections. The key is responding quickly with coordinated revisions instead of piecemeal answers that create another review cycle.',
    items: ['Complete application package', 'Review comments tracked by discipline', 'Revised plans resubmitted as one coordinated package'],
  },
  {
    title: 'Plan inspections before construction starts',
    why: 'Permitting does not end at approval. Foundation, framing, MEP, insulation, and final inspections should be planned into the construction schedule.',
    items: ['Inspection sequence aligned with schedule', 'Trade work ready before inspection calls', 'Final closeout documented before handoff'],
  },
];
const quickChecks = ['Jurisdiction', 'Setbacks', 'Floodplain', 'Drainage', 'Utilities', 'Engineering', 'HOA/deed restrictions', 'Inspection sequence'];
---
<Layout title="Houston Permit Guide | Custom Home Permitting" description="Step-by-step Houston custom home permit guide covering drawings, engineering, site plans, city or county review, revisions, approvals, and inspections." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, guideSchema]}>
  <section class="relative min-h-[48vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 pt-36 pb-20 md:pt-44 md:pb-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Houston Permit Guide</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">A practical permitting roadmap for Houston-area custom homes. Use it to understand what must be coordinated before permit submission, during review, and through inspections.</p>
    </div>
  </section>

  <section class="stone-section">
    <div class="container-main section-padding">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="editorial-card p-6 md:p-8 self-start">
          <p class="eyebrow">Before You Submit</p>
          <h2 class="mt-4 font-heading text-3xl text-[#17202a]">Quick readiness check</h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            {quickChecks.map((item) => (
              <div class="flex items-center gap-3 border border-[rgba(71,57,40,.14)] bg-[#fffaf2] px-4 py-3">
                <span class="h-2 w-2 rounded-full bg-[#b88a4a]"></span>
                <span class="text-sm font-medium text-[#17202a]/78">{item}</span>
              </div>
            ))}
          </div>
          <p class="mt-6 text-sm leading-7 text-[#17202a]/68">This is educational only. Exact requirements depend on the property, jurisdiction, floodplain status, scope, and reviewer comments.</p>
          <a href="/contact" class="btn-luxe-fill mt-7">Discuss Your Permit Path</a>
        </aside>

        <div class="space-y-5">
          {permitSteps.map((step, index) => (
            <article class="editorial-card p-6 md:p-8">
              <p class="eyebrow">Step {index + 1}</p>
              <h2 class="mt-3 font-heading text-3xl text-[#17202a]">{step.title}</h2>
              <p class="mt-4 leading-7 text-[#17202a]/72">{step.why}</p>
              <ul class="mt-5 grid gap-3 sm:grid-cols-3">
                {step.items.map((item) => (
                  <li class="border border-[rgba(71,57,40,.14)] bg-white/70 p-4 text-sm leading-6 text-[#17202a]/74">{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-12 border-t border-[rgba(71,57,40,.14)] pt-8">
        <p class="eyebrow">Related Next Steps</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/services/plans-permits-engineering" class="btn-luxe">Plans, Permits & Engineering</a>
          <a href="/services/custom-home-design-build" class="btn-luxe">Design-Build Process</a>
          <a href="/tools/lot-feasibility-checklist" class="btn-luxe">Lot Feasibility Checklist</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
