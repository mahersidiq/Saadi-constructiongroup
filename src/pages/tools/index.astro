---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const tools = [
  { href: '/tools/build-cost-calculator', title: 'Build Cost Calculator', text: 'Estimate planning ranges for Houston custom home construction.' },
  { href: '/tools/timeline-estimator', title: 'Custom Home Timeline Estimator', text: 'Understand preconstruction, permitting, and construction duration.' },
  { href: '/tools/houston-permit-guide', title: 'Houston Permit Guide', text: 'Review drawings, engineering, city or county review, revisions, approvals, and inspections.' },
  { href: '/tools/lot-feasibility-checklist', title: 'Lot Feasibility Checklist', text: 'Check zoning, setbacks, utilities, drainage, floodplain, easements, access, soil, and HOA items.' },
];
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
  { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' },
] };
---
<Layout title="Custom Home Planning Tools | Saadi Construction Group" description="Houston custom home planning tools for cost, timeline, permitting, and lot feasibility. Planning ranges only; request a consultation for project-specific guidance." canonicalUrl="https://www.saadiconstructiongroup.com/tools" jsonLd={breadcrumbSchema}>
  <section class="relative min-h-[48vh] flex items-center bg-gradient-to-br from-[#2a2018] via-[#2a2018] to-[#171512] overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 pt-36 pb-20 md:pt-44 md:pb-28 text-center">
      <p class="eyebrow text-[#b88a4a]">Planning Resources</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#fffaf1] leading-tight mt-4">Custom Home Planning Tools</h1>
      <p class="mt-6 text-lg text-[#d7c8b3] max-w-2xl mx-auto">Educational tools for Houston homeowners evaluating cost, schedule, permits, and lot readiness.</p>
    </div>
  </section>
  <section class="section-padding bg-[#fffaf2]">
    <div class="container-main px-4 grid gap-6 md:grid-cols-2">
      {tools.map((tool) => (
        <a href={tool.href} class="block rounded-xl border border-[rgba(71,57,40,.16)] bg-[#fffaf2] p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
          <h2 class="font-heading text-2xl font-bold text-[#17140f]">{tool.title}</h2>
          <p class="mt-3 text-[#17140f]/68 leading-relaxed">{tool.text}</p>
          <span class="mt-5 inline-block text-sm font-semibold text-[#b88a4a]">Open tool →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
