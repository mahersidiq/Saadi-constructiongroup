---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
const canonical = 'https://www.saadiconstructiongroup.com/tools/timeline-estimator';
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.saadiconstructiongroup.com/tools' }] };
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Custom Home Timeline Estimator', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, publisher: { '@type': 'Organization', name: 'Saadi Construction Group' } };
---
<Layout title="Custom Home Timeline Estimator | Houston" description="Estimate Houston custom home preconstruction, permitting, and construction duration based on project type, design status, permit status, size, and complexity." canonicalUrl={canonical} jsonLd={[breadcrumbSchema, softwareSchema]}>
  <section class="relative min-h-[42vh] flex items-center bg-gradient-to-br from-navy via-[#14304d] to-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,149,42,0.08),transparent_60%)]"></div>
    <div class="relative z-10 container-main px-4 py-20 md:py-28">
      <p class="eyebrow text-gold">Houston Planning Tool</p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mt-4">Custom Home Timeline Estimator</h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl">Use this estimator to understand the planning window for design, engineering, permits, construction, and final walkthrough before requesting a detailed schedule.</p>
    </div>
  </section>
  <section class="section-padding bg-white"><div class="container-main px-4 max-w-4xl"><div class="grid gap-6 md:grid-cols-2"><label class="block text-sm font-semibold text-charcoal">Project type<select id="type" class="mt-2 w-full border border-gray-300 p-3"><option value="8">Custom home</option><option value="5">Addition/remodel</option></select></label><label class="block text-sm font-semibold text-charcoal">Design status<select id="designStatus" class="mt-2 w-full border border-gray-300 p-3"><option value="10">No plans yet</option><option value="5">Concept only</option><option value="1">Permit-ready plans</option></select></label><label class="block text-sm font-semibold text-charcoal">Permit status<select id="permit" class="mt-2 w-full border border-gray-300 p-3"><option value="10">Not submitted</option><option value="5">Submitted</option><option value="0">Approved</option></select></label><label class="block text-sm font-semibold text-charcoal">Home size<select id="size" class="mt-2 w-full border border-gray-300 p-3"><option value="0">Under 3,000 sq ft</option><option value="2">3,000–5,000 sq ft</option><option value="4">Over 5,000 sq ft</option></select></label><label class="block text-sm font-semibold text-charcoal">Complexity<select id="complexity" class="mt-2 w-full border border-gray-300 p-3"><option value="0">Standard</option><option value="3">Moderate</option><option value="6">Complex</option></select></label></div><div class="mt-10 rounded-lg bg-light-gray p-6 border border-gray-200"><h2 class="font-heading text-3xl text-charcoal">Estimated timeline</h2><p id="timeline-output" class="mt-4 text-xl font-bold text-navy"></p><p class="mt-3 text-gray-700">Planning range only. Actual schedules depend on jurisdiction review, revisions, selections, procurement, weather, and site conditions.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/services/custom-home-design-build" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">Houston custom home design-build</a><a href="/services/plans-permits-engineering" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">plans, permits, and engineering</a><a href="/contact" class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">schedule a consultation</a></div></div></div></section><script>function calcTimeline(){const vals=['type','designStatus','permit','size','complexity'].map(id=>Number(document.getElementById(id).value));const pre=vals[1]+vals[2]+2;const build=vals[0]+vals[3]+vals[4]+18;document.getElementById('timeline-output').textContent='Preconstruction: '+pre+'–'+(pre+6)+' weeks · Construction: '+build+'–'+(build+10)+' weeks · Total planning range: '+Math.round((pre+build)/4)+'–'+Math.round((pre+build+16)/4)+' months';}document.querySelectorAll('select').forEach(el=>el.addEventListener('input',calcTimeline));calcTimeline();</script>
</Layout>
