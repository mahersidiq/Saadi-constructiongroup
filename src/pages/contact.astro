---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/islands/ContactForm.jsx';
---

<Layout 
  title="Schedule Lot Feasibility & Custom Home Consultation | Saadi Construction Group" 
  description="Request a private architectural design-build consultation with Saadi Construction Group. Lot feasibility, setback reviews, and fixed-price scope parameters within 5 business days." 
  keywords="custom home consultation Houston, Memorial lot feasibility, River Oaks luxury custom home quote, West University design build" 
  canonicalUrl="https://www.saadiconstructiongroup.com/contact"
  pageType="ContactPage"
  ogImage="/images/hero-memorial-residence.jpg"
  ogImageAlt="Schedule a custom home design-build consultation in Houston with Saadi Construction Group"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact' },
  ]}
>
  {/* Architectural Header */}
  <section class="relative min-h-[64vh] overflow-hidden bg-[#1c1917] text-[#fffdf8]">
    <img 
      src="/images/hero-memorial-residence.jpg" 
      alt="Architectural modern custom residence in Memorial Houston" 
      class="absolute inset-0 h-full w-full object-cover opacity-60" 
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/70 to-black/30"></div>
    <div class="relative container-main flex min-h-[64vh] items-end pb-16 pt-36">
      <div class="max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-[0.26em] text-[#dfc8a7]">Direct Builder Consultation</p>
        <h1 class="font-heading mt-4 text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-[#fffdf8]">
          Begin With Complete Preconstruction Clarity.
        </h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[#dfd7ca]">
          Tell us about your lot, target neighborhood, or architectural concept. We provide preliminary lot feasibility assessments and budget parameters within five business days.
        </p>
      </div>
    </div>
  </section>

  {/* Form & Office Information */}
  <section class="bg-[#fbf9f5] py-24 md:py-32">
    <div class="container-main">
      <div class="grid gap-16 lg:grid-cols-12 lg:items-start">
        {/* Interactive Consultation Form */}
        <div class="lg:col-span-7 border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-8 sm:p-12 shadow-sm">
          <div class="mb-8">
            <h2 class="font-heading text-3xl font-medium text-[#1c1917]">Request Project Feasibility Review</h2>
            <p class="mt-2 text-xs font-mono text-[#8c6d46] uppercase tracking-wider">
              Single-Contract Turnkey Design-Build
            </p>
          </div>
          <ContactForm client:load />
        </div>

        {/* Office & Direct Contact Info */}
        <aside class="lg:col-span-5 space-y-8">
          <div class="bg-[#1c1917] p-8 sm:p-10 text-[#fffdf8] shadow-md border border-[rgba(255,255,255,0.08)]">
            <p class="font-mono text-xs uppercase tracking-[0.24em] text-[#dfc8a7]">Direct Contact</p>
            <a 
              href="tel:+18323603804" 
              class="font-heading text-3xl sm:text-4xl text-[#fffdf8] hover:text-[#dfc8a7] transition-colors mt-4 block"
            >
              (832) 360-3804
            </a>
            <a 
              href="mailto:info@saadiconstructiongroup.com" 
              class="mt-3 block font-mono text-xs text-[#dfc8a7] hover:underline"
            >
              info@saadiconstructiongroup.com
            </a>
            <div class="mt-8 pt-6 border-t border-[rgba(255,255,255,0.1)] text-xs text-[#dfd7ca] font-mono leading-relaxed">
              <strong class="text-white block uppercase tracking-wider mb-1">Houston Corporate Office:</strong>
              801 Travis St, Suite 2101<br />
              Houston, TX 77002
            </div>
          </div>

          <div class="border border-[rgba(28,25,23,0.08)] bg-[#f6f3ec] p-8 sm:p-10">
            <h3 class="font-heading text-2xl text-[#1c1917]">Primary Building Markets</h3>
            <p class="mt-3 text-xs leading-relaxed text-[#1c1917]/75">
              Active custom home builds and architectural planning across <strong>Memorial</strong>, <strong>River Oaks</strong>, <strong>West University Place</strong>, <strong>Tanglewood</strong>, <strong>The Woodlands</strong>, and <strong>Sugar Land</strong>.
            </p>
            <div class="mt-6 pt-4 border-t border-[rgba(28,25,23,0.08)]">
              <span class="font-mono text-[10px] uppercase tracking-wider text-[#8c6d46]">Turnaround Commitment:</span>
              <p class="text-xs text-[#1c1917]/80 mt-1">Written proposal & feasibility review within 5 business days of site visit.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
