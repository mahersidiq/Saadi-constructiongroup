---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/islands/ContactForm.jsx';
---
<Layout title="Request a Custom Home Quote | Saadi Construction Group | Houston, TX" description="Request a custom home build quote from Saadi Construction Group. We handle plans, engineering, permits, and construction. Detailed quote within 5 business days." keywords="custom home quote Houston, custom home builder quote, design-build quote Houston TX" canonicalUrl="https://www.saadiconstructiongroup.com/contact">
  <section class="relative min-h-[62vh] overflow-hidden bg-[#2a2018] text-[#fff8ed]"><img src="/images/p8-exterior-aerial.png" alt="Modern Houston custom home interior opening to a pool" class="absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-[#171512]/90 via-[#171512]/60 to-transparent"></div><div class="relative container-main flex min-h-[62vh] items-end pb-16 pt-36"><div class="max-w-4xl"><p class="eyebrow">Start the Conversation</p><h1 class="display-heading mt-4 text-5xl text-[#fff8ed] md:text-7xl">Tell us where you are in the custom-home journey.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-[#fff8ed]/80">Tell us about your lot, plans, budget, timeline, or current stage. We’ll help determine the right path.</p></div></div></section>
  <section class="stone-section"><div class="container-main section-padding"><div class="grid gap-10 lg:grid-cols-[1.2fr_.8fr]"><div class="editorial-card p-5 md:p-8"><ContactForm client:load /></div><aside class="space-y-5"><div class="bg-[#2a2018] p-8 text-[#fff8ed]"><p class="eyebrow">Contact</p><a href="tel:+18322058178" class="mt-5 block text-2xl font-heading text-[#fff8ed]">(832) 205-8178</a><a href="mailto:info@saadiconstructiongroup.com" class="mt-3 block break-all text-[#e7c797]">info@saadiconstructiongroup.com</a><p class="mt-5 leading-7 text-[#fff8ed]/76">801 Travis St Suite 2101<br />Houston, TX 77002</p></div><div class="border border-[rgba(71,57,40,.14)] bg-[#fffaf2] p-8"><h2 class="font-heading text-3xl">Houston and surrounding areas</h2><p class="mt-4 leading-7 text-[#17140f]/70">Serving custom home clients across Greater Houston with plans, permitting, engineering, and construction coordination under one contract.</p></div></aside></div></div></section>
</Layout>
