---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import ServiceHero from '@/components/sections/services/ServiceHero.astro';
import ServiceIncludes from '@/components/sections/services/ServiceIncludes.astro';
import RelatedServices from '@/components/sections/services/RelatedServices.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';
import { allServices } from '@/data/services';
import { serviceDetails } from '@/data/serviceDetails';

export function getStaticPaths() {
  return allServices.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = allServices.find((s) => s.slug === slug);
if (!service) return Astro.redirect('/404');

const detail = serviceDetails[slug] || {};

const relatedSlugs = detail.relatedSlugs || [];
const relatedServices = relatedSlugs
  .map((rSlug) => allServices.find((s) => s.slug === rSlug))
  .filter(Boolean);

const faqs = detail.faqs || [];
const canonical = `https://www.saadiconstructiongroup.com/services/${slug}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: detail.title || service.name,
  description: detail.metaDescription || `${service.name} services in Houston, TX.`,
  provider: {
    '@type': 'GeneralContractor',
    '@id': 'https://www.saadiconstructiongroup.com/#organization',
    name: 'Saadi Construction Group',
    url: 'https://www.saadiconstructiongroup.com',
    telephone: '+18323603804',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Greater Houston Metropolitan Area, TX',
  },
  serviceType: detail.title || service.name,
  url: canonical,
};

const resourceLinks = [
  { href: '/blog/cost-to-build-custom-home-houston', anchor: 'Houston custom home cost guide' },
  { href: '/blog/houston-custom-home-construction-timeline', anchor: 'custom home timeline guide' },
  { href: '/blog/houston-permitting-process-custom-homes', anchor: 'Houston permitting guide' },
  { href: '/tools/build-cost-calculator', anchor: 'build cost calculator' },
  { href: '/tools/timeline-estimator', anchor: 'timeline estimator' },
  { href: '/projects', anchor: 'custom home portfolio' },
  { href: '/service-areas/houston', anchor: 'Houston service area' },
  { href: '/contact', anchor: 'schedule a consultation' },
];
---

<Layout
  title={detail.metaTitle || `${service.name} Houston TX | Saadi Construction Group`}
  description={detail.metaDescription || `Custom ${service.name.toLowerCase()} in Houston, TX from Saadi Construction Group.`}
  keywords={detail.keywords || `${service.name} Houston TX, custom home builder Houston`}
  canonicalUrl={canonical}
  ogImage="/images/p2-exterior-front.png"
  ogImageAlt={`${detail.title || service.name} — Saadi Construction Group Houston TX`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    { name: detail.title || service.name, href: `/services/${slug}` },
  ]}
  faqs={faqs}
  speakableSelectors={['h1', 'h2', '.what-is-it p', 'details summary', 'details p']}
  jsonLd={serviceSchema}
>
  <ServiceHero title={detail.title || service.name} subheadline={detail.subheadline} category={detail.category} />
  <ServiceIncludes includes={detail.includes} whatIsIt={detail.whatIsIt} bestFor={detail.bestFor} />

  {faqs.length > 0 && (
    <section class="py-20 md:py-24 bg-[#fbf9f5] border-b border-[rgba(28,25,23,0.08)]">
      <div class="container-main max-w-4xl">
        <div class="mb-10">
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">Technical Advisory</p>
          <h2 class="font-heading text-3xl md:text-4xl font-medium text-[#1c1917]">Frequently Asked Questions</h2>
        </div>
        <div class="divide-y divide-[rgba(28,25,23,0.1)] border-y border-[rgba(28,25,23,0.1)]">
          {faqs.map((faq) => (
            <details class="group py-6 cursor-pointer">
              <summary class="flex items-center justify-between gap-4 list-none font-heading font-medium text-xl text-[#1c1917] group-open:text-[#8c6d46]">
                {faq.question}
                <span class="font-sans text-xl text-[#8c6d46] transition-transform duration-200 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 font-sans text-sm text-[#1c1917]/75 leading-7">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 bg-[#f6f3ec] border-b border-[rgba(28,25,23,0.08)]">
    <div class="container-main max-w-4xl">
      <div class="mb-5">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">Homeowner Resources</p>
        <h2 class="font-heading text-3xl font-medium text-[#1c1917]">Plan your next step with related Houston guides.</h2>
      </div>
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-[#1c1917]/75">
        {resourceLinks.map((link, idx) => (
          <>
            <a href={link.href} class="hover:text-[#8c6d46] transition-colors">{link.anchor}</a>
            {idx < resourceLinks.length - 1 && <span aria-hidden="true" class="text-[#8c6d46]">·</span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <RelatedServices relatedServices={relatedServices} />
  <CTABanner />
</Layout>
