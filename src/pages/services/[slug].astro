---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import ServiceHero from '@/components/sections/services/ServiceHero.astro';
import ServiceIncludes from '@/components/sections/services/ServiceIncludes.astro';
import RelatedServices from '@/components/sections/services/RelatedServices.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';
import { allServices } from '@/data/services';
import { serviceDetails } from '@/data/serviceDetails';

export function getStaticPaths() {
  return allServices.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = allServices.find((s) => s.slug === slug);
if (!service) return Astro.redirect('/404');

const detail = serviceDetails[slug] || {};

const relatedSlugs = detail.relatedSlugs || [];
const relatedServices = relatedSlugs
  .map((rSlug) => allServices.find((s) => s.slug === rSlug))
  .filter(Boolean);

const faqs = detail.faqs || [];
const canonical = `https://www.saadiconstructiongroup.com/services/${slug}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: detail.title || service.name,
  description: detail.metaDescription || `${service.name} services in Houston, TX.`,
  provider: {
    '@type': 'GeneralContractor',
    name: 'Saadi Construction Group',
    url: 'https://www.saadiconstructiongroup.com',
    telephone: '(832) 205-8178',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '801 Travis St Suite 2101',
      addressLocality: 'Houston',
      addressRegion: 'TX',
      postalCode: '77002',
      addressCountry: 'US',
    },
  },
  areaServed: 'Greater Houston Metropolitan Area',
  serviceType: detail.title || service.name,
  url: canonical,
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.saadiconstructiongroup.com' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.saadiconstructiongroup.com/services' },
    { '@type': 'ListItem', position: 3, name: detail.title || service.name, item: canonical },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: detail.title || service.name,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'h2', '.what-is-it p', 'details summary', 'details p'],
  },
  url: canonical,
};

const resourceLinks = [
  { href: '/blog/cost-to-build-custom-home-houston', anchor: 'Houston custom home cost guide' },
  { href: '/blog/houston-custom-home-construction-timeline', anchor: 'custom home timeline guide' },
  { href: '/blog/houston-permitting-process-custom-homes', anchor: 'Houston permitting guide' },
  { href: '/tools/build-cost-calculator', anchor: 'build cost calculator' },
  { href: '/tools/timeline-estimator', anchor: 'timeline estimator' },
  { href: '/projects', anchor: 'custom home portfolio' },
  { href: '/service-areas/houston', anchor: 'Houston service area' },
  { href: '/contact', anchor: 'schedule a consultation' },
];

const jsonLd = faqSchema
  ? [serviceSchema, faqSchema, breadcrumbSchema, speakableSchema]
  : [serviceSchema, breadcrumbSchema, speakableSchema];
---

<Layout
  title={detail.metaTitle || `${service.name} Houston TX | Saadi Construction Group`}
  description={detail.metaDescription || `Custom ${service.name.toLowerCase()} in Houston, TX from Saadi Construction Group.`}
  keywords={detail.keywords || `${service.name} Houston TX, custom home builder Houston`}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <ServiceHero title={detail.title || service.name} subheadline={detail.subheadline} category={detail.category} />
  <ServiceIncludes includes={detail.includes} whatIsIt={detail.whatIsIt} bestFor={detail.bestFor} />

  {faqs.length > 0 && (
    <section class="py-16 md:py-24 bg-white">
      <div class="container-main px-4 max-w-3xl">
        <div class="animate-on-scroll mb-10">
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-charcoal">Frequently Asked Questions</h2>
        </div>
        <div class="divide-y divide-gray-200">
          {faqs.map((faq) => (
            <details class="animate-on-scroll group py-6 cursor-pointer">
              <summary class="flex items-center justify-between gap-4 list-none font-heading font-semibold text-lg text-charcoal">
                {faq.question}
                <svg class="h-5 w-5 flex-shrink-0 text-gold transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-4 text-gray-700 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 bg-light-gray border-y border-gray-200">
    <div class="container-main px-4 max-w-4xl">
      <div class="animate-on-scroll mb-8">
        <p class="text-sm font-semibold uppercase tracking-widest text-gold mb-3">Homeowner Resources</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-charcoal">Plan your next step with related Houston guides.</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        {resourceLinks.map((link) => (
          <a href={link.href} class="inline-block px-4 py-2 rounded-full bg-white border border-gray-300 text-sm font-medium text-charcoal hover:border-gold hover:text-gold transition-colors duration-200">{link.anchor}</a>
        ))}
      </div>
    </div>
  </section>

  <RelatedServices relatedServices={relatedServices} />
  <CTABanner />
</Layout>
