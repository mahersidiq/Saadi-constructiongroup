---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { allServices } from '@/data/services';
---
<Layout title="Custom Home Builder Services Houston TX | Saadi Construction Group" description="Premium custom home design-build, luxury custom homes, new construction, additions, plans, permits, engineering, and construction management in Houston TX." keywords="custom home builder services Houston, custom home design-build Houston, new home construction Houston TX" canonicalUrl="https://www.saadiconstructiongroup.com/services">
  <section class="relative min-h-[68vh] overflow-hidden bg-[#0d0c0a] text-[#fff8ed]"><img src="/images/p2-interior-bath.png" alt="Luxury custom home exterior in Houston at dusk" class="absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_15%_54%,rgba(0,0,0,.86),rgba(13,12,10,.62)_42%,rgba(13,12,10,.18)_72%),linear-gradient(90deg,rgba(0,0,0,.9),rgba(0,0,0,.2))]"></div><div class="relative container-main flex min-h-[68vh] items-end pb-16 pt-36"><div class="max-w-4xl"><p class="eyebrow">Services</p><h1 class="display-heading mt-4 text-5xl text-[#fff8ed] md:text-7xl">Plans, permits, engineering, and construction under one contract.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-[#fff8ed]/80">A polished design-build path for Houston homeowners who want accountability before, during, and after construction.</p></div></div></section>
  <section class="stone-section"><div class="container-main section-padding"><div class="mb-14 max-w-3xl"><p class="eyebrow">Service Pillars</p><h2 class="display-heading mt-4 text-4xl md:text-6xl">Builder services that stay connected from concept to handoff.</h2></div><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{allServices.map((service) => <a href={`/services/${service.slug}`} class="luxe-card group flex min-h-[320px] flex-col p-8"><p class="eyebrow">{service.category}</p><h2 class="mt-5 font-heading text-3xl text-[#17140f] group-hover:text-[#6f563f]">{service.name}</h2><p class="mt-5 text-sm leading-7 text-[#17140f]/70 group-hover:text-[#6f563f]/74">{service.description}</p><span class="mt-auto pt-8 inline-flex text-[11px] font-semibold uppercase tracking-[0.18em] text-[#b88a4a]">Learn more →</span></a>)}</div></div></section>
  <section class="dark-section text-[#fff8ed]"><div class="container-main py-20 text-center"><h2 class="font-heading text-5xl text-[#fff8ed]">Not sure which service fits your stage?</h2><p class="mx-auto mt-4 max-w-xl text-[#fff8ed]/76">Tell us about your lot, plans, budget, timeline, or current stage. We’ll help determine the right path.</p><a href="/contact" class="btn-luxe-fill mt-8">Schedule Free Consultation</a></div></section>
</Layout>
