---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/home/Hero.astro';
import TrustBar from '@/components/sections/home/TrustBar.astro';
import StatsBar from '@/components/sections/home/StatsBar.astro';
import OneStopCallout from '@/components/sections/home/OneStopCallout.astro';
import ServicesGrid from '@/components/sections/home/ServicesGrid.astro';
import WhySaadi from '@/components/sections/home/WhySaadi.astro';
import FeaturedProjects from '@/components/sections/home/FeaturedProjects.astro';
import Process from '@/components/sections/home/Process.astro';
import ServiceAreas from '@/components/sections/home/ServiceAreas.astro';
import FAQ from '@/components/sections/home/FAQ.astro';
import CTABanner from '@/components/sections/home/CTABanner.astro';

const homeFaqs = [
  {
    question: 'Do you handle architectural plans, structural engineering, and permits under one contract?',
    answer: 'Yes. Saadi Construction Group manages architectural drafting, geotechnical soil borings, PE-stamped post-tension foundation engineering, HOA/ARC submissions, and City of Houston or county building permits in-house. You do not need to hire or coordinate a separate architect, structural engineer, or permit expediter—one fixed-price contract covers your entire build from raw lot to Certificate of Occupancy.',
  },
  {
    question: 'How much does it cost to build a custom home in Houston TX in 2026?',
    answer: 'In Greater Houston, custom home construction in 2026 falls into three tiers: $250–$350 per square foot for Entry Luxury Custom (master-planned community lots with streamlined site work), $350–$500 per square foot for Architectural Luxury Custom (bespoke elevations, engineered post-tension slabs, premium millwork and glazing), and $500–$900+ per square foot for Bespoke Estates on Inner-Loop tear-down lots in River Oaks, Memorial Villages, Tanglewood, and West University Place (excluding land acquisition and pool). Saadi Construction Group delivers a written scope and fixed-price proposal after lot feasibility and preconstruction engineering.',
  },
  {
    question: 'How long does it take to build a custom home in Houston?',
    answer: 'A luxury custom home in Houston typically takes 14–22 months from design-build contract signature to move-in. This includes 4–7 months of preconstruction (soil borings, architectural plans, structural engineering, HOA/ARC approval, and municipal permitting) followed by 10–15 months of on-site construction. Simpler builds on cleared lots can complete in 12–14 months.',
  },
  {
    question: 'What Houston neighborhoods and counties do you build in?',
    answer: 'We build across Greater Houston including Memorial Villages (Piney Point, Hunters Creek, Bunker Hill, Hedwig), River Oaks, West University Place, Bellaire, Tanglewood, Houston Heights, The Woodlands, Sugar Land, Katy, Fulshear, Pearland, Cypress, Spring, Conroe, League City, Friendswood, Kingwood, Richmond, and Missouri City—covering Harris, Fort Bend, Montgomery, Brazoria, and Galveston Counties.',
  },
  {
    question: 'Do you build on my lot or help evaluate a teardown property before purchase?',
    answer: 'We build on your lot and provide complimentary pre-purchase lot feasibility walks. Before you close on a teardown or acreage parcel, our team evaluates municipal jurisdiction, deed restrictions, building setbacks, Chapter 19 floodplain status, stormwater detention requirements, protected specimen oaks, and expansive clay foundation implications.',
  },
  {
    question: 'What is a single-contract design-build builder and why does it prevent budget overruns?',
    answer: 'In a traditional bid-build model, an independent architect draws plans without real-time contractor cost data—often resulting in construction bids 30–40% over budget. Under Saadi Construction Group’s single-contract design-build model, our architects, structural engineers, and field superintendents engineer your home to your exact budget from the first sketch. One contract, one point of contact, and zero finger-pointing.',
  },
];

const designBuildHowToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://www.saadiconstructiongroup.com/#design-build-process',
  name: 'How to Design and Build a Custom Home in Houston, TX',
  description: 'The 7-stage engineering and construction protocol used by Saadi Construction Group to deliver fixed-price luxury custom homes across Greater Houston.',
  totalTime: 'P16M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'USD',
    minValue: '950000',
    maxValue: '6500000',
  },
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Consultation, Boundary & Lot Feasibility', text: 'Evaluate property boundaries, specimen tree ordinances, municipal setback envelopes, and Chapter 19 floodplain benchmarks.' },
    { '@type': 'HowToStep', position: 2, name: 'Architectural Design & Space Planning', text: 'Produce schematic floor plans, exterior elevations, and window schedules aligned with neighborhood ARC guidelines.' },
    { '@type': 'HowToStep', position: 3, name: 'Geotechnical Soil Borings & Structural Engineering', text: 'Perform soil core borings to measure Beaumont clay Plasticity Index (PI) and engineer a custom stiffened post-tension slab or pier foundation.' },
    { '@type': 'HowToStep', position: 4, name: 'City Permitting & Civil Drainage Approval', text: 'Submit sealed architectural, structural, and civil stormwater detention plans to the Houston Permitting Center or local municipality.' },
    { '@type': 'HowToStep', position: 5, name: 'Foundation Pour, Framing & MEP Rough-Ins', text: 'Execute post-tension slab pour with third-party cylinder tests, dimensional framing, ZIP System weather barrier, and multi-stage HVAC/MEP rough-ins.' },
    { '@type': 'HowToStep', position: 6, name: 'Architectural Enclosure & Level 5 Interior Millwork', text: 'Install limestone/brick masonry, standing-seam metal or slate roofing, Level 5 drywall, custom inset cabinetry, and wide-plank white oak flooring.' },
    { '@type': 'HowToStep', position: 7, name: 'Commissioning, Thermal Audit & Turnkey Handover', text: 'Complete mechanical commissioning, thermal envelope verification, Certificate of Occupancy inspection, and digital as-built handover.' },
  ],
};

const pageTitle = 'Houston Luxury Custom Home Builder | Saadi Construction Group';
const pageDescription = "Houston's premier design-build custom home builder. Architectural plans, structural engineering, permits & luxury construction in Memorial, River Oaks & West U.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="custom home builder Houston, luxury custom home builder Houston TX, Memorial custom homes, River Oaks design build, West University Place custom builder, general contractor Houston"
  canonicalUrl="https://www.saadiconstructiongroup.com"
  ogImage="/images/saadi-custom-home-exterior.jpg"
  ogImageAlt="Architectural luxury custom residence in Memorial Houston built by Saadi Construction Group"
  faqs={homeFaqs}
  speakableSelectors={['h1', '.hero-description', '.aeo-direct-answer', '.section-heading']}
  jsonLd={designBuildHowToSchema}
>
  <Hero />
  <TrustBar />
  <StatsBar />
  <OneStopCallout />
  <ServicesGrid />
  <WhySaadi />
  <FeaturedProjects />
  <Process />
  <FAQ faqs={homeFaqs} />
  <ServiceAreas />

  {/* AEO Direct Answer & Houston Homeowner Planning Matrix */}
  <section class="py-20 bg-[#f6f3ec] border-t border-[rgba(28,25,23,0.08)]">
    <div class="container-main max-w-5xl">
      <div class="text-center max-w-3xl mx-auto">
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[#8c6d46] mb-3">Houston Custom Home Quick Reference</p>
        <h2 class="font-heading section-heading text-3xl md:text-4xl font-medium text-[#1c1917] mb-5">
          2026 Houston Custom Home Building Benchmarks
        </h2>
        <p class="aeo-direct-answer font-sans text-sm md:text-base text-[#1c1917]/80 leading-7 mb-10">
          <strong>Saadi Construction Group</strong> is an owner-led Houston design-build custom home builder (801 Travis St, Suite 2101, Houston, TX 77002 · <a href="tel:+18323603804" class="underline hover:text-[#8c6d46]">(832) 360-3804</a>) delivering architectural plans, geotechnical soil testing, PE-stamped post-tension slab engineering, municipal permitting, and turnkey luxury construction under one fixed-price contract. In 2026, Houston custom home construction ranges from <strong>$250–$350/sq ft</strong> (Entry Luxury), <strong>$350–$500/sq ft</strong> (Architectural Luxury), to <strong>$500–$900+/sq ft</strong> (Bespoke Inner-Loop Estates), with a typical turnkey timeline of <strong>14–22 months</strong>.
        </p>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-y-2 gap-x-4 text-xs font-mono uppercase tracking-[0.16em] text-[#1c1917]/75 pt-6 border-t border-[rgba(28,25,23,0.08)]">
        <a href="/services/custom-home-design-build" class="hover:text-[#8c6d46] transition-colors">Design-Build Services</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/blog/cost-to-build-custom-home-houston" class="hover:text-[#8c6d46] transition-colors">2026 Cost to Build Guide</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/tools/build-cost-calculator" class="hover:text-[#8c6d46] transition-colors">Build Cost Calculator</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/tools/timeline-estimator" class="hover:text-[#8c6d46] transition-colors">Timeline Estimator</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/tools/lot-feasibility-checklist" class="hover:text-[#8c6d46] transition-colors">Lot Feasibility Checklist</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/tools/houston-permit-guide" class="hover:text-[#8c6d46] transition-colors">Houston Permit Guide</a>
        <span aria-hidden="true" class="text-[#8c6d46]">·</span>
        <a href="/contact" class="hover:text-[#8c6d46] transition-colors">Schedule Consultation</a>
      </div>
    </div>
  </section>
  <CTABanner />
</Layout>
