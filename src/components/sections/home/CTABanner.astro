---
---

<section class="relative overflow-hidden min-h-[70vh] flex items-center">
  <!-- Background image -->
  <img
    src="/images/p3-exterior-front.png"
    alt="Saadi Construction Group luxury Houston home"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/80"></div>
  <!-- Gold gradient overlay -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 50%, rgba(201,149,42,0.08) 0%, transparent 60%)"></div>

  <!-- Gold top accent line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

  <div class="relative z-10 container-main px-6 py-24 w-full">
    <div class="max-w-3xl mx-auto text-center">

      <!-- Eyebrow -->
      <div class="animate-on-scroll mb-8">
        <span class="section-label">Let's Build Together</span>
      </div>

      <!-- Script tagline -->
      <div class="animate-on-scroll mb-6">
        <span class="font-script text-gold text-3xl md:text-4xl" style="font-family: 'Great Vibes', cursive;">
          We build more than homes,
        </span>
      </div>

      <!-- Bold statement -->
      <h2 class="animate-on-scroll font-heading font-light text-white text-5xl md:text-6xl lg:text-7xl tracking-[0.1em] uppercase mb-3">
        WE BUILD
      </h2>
      <h2 class="animate-on-scroll font-heading font-light text-gold text-5xl md:text-6xl lg:text-7xl tracking-[0.1em] uppercase mb-12">
        LEGACIES.
      </h2>

      <div class="animate-on-scroll gold-line mb-10"></div>

      <!-- Subtext -->
      <p class="animate-on-scroll font-body text-sm text-white/50 max-w-lg mx-auto leading-relaxed font-light tracking-wide mb-12">
        If you're ready to bring your vision to life, we're here to help.
        Schedule a free consultation and receive a detailed quote within 5 business days.
      </p>

      <!-- CTAs -->
      <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/contact" class="btn-primary">
          Schedule Free Consultation
        </a>
        <a href="tel:8322058178" class="flex items-center gap-2 font-body text-xs tracking-[0.2em] uppercase text-white/50 hover:text-gold transition-colors duration-300">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          (832) 205-8178
        </a>
      </div>

      <!-- Contact row -->
      <div class="animate-on-scroll mt-14 flex flex-wrap items-center justify-center gap-8 pt-10 border-t border-gold/15">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-gold/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <span class="font-body text-xs text-white/40 tracking-wide">info@saadiconstructiongroup.com</span>
        </div>
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-gold/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <span class="font-body text-xs text-white/40 tracking-wide">801 Travis St Ste 2101, Houston, TX 77002</span>
        </div>
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-gold/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253" />
          </svg>
          <span class="font-body text-xs text-white/40 tracking-wide">saadiconstructiongroup.com</span>
        </div>
      </div>
    </div>
  </div>
</section>
