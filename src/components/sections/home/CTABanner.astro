---
---

<section class="relative min-h-[70vh] flex items-center overflow-hidden grain">
  <!-- Background image -->
  <img
    src="/images/p3-exterior-front.png"
    alt="Saadi Construction Group luxury Houston home"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <!-- Deep cinematic overlay -->
  <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(5,5,5,0.92) 0%, rgba(5,5,5,0.75) 50%, rgba(5,5,5,0.88) 100%);"></div>

  <!-- Diagonal top cut -->
  <div class="absolute top-0 left-0 right-0 overflow-hidden" style="height:60px;">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width:100%; height:60px; display:block;">
      <polygon points="0,0 1440,0 0,60" fill="#111111"/>
    </svg>
  </div>

  <div class="relative z-10 container-main px-6 py-28 w-full text-center">

    <!-- Bold Inter headline -->
    <h2 class="animate-on-scroll font-body font-extrabold uppercase" style="font-size:clamp(2.8rem,6vw,5.5rem); color:#F5F5F5; line-height:0.95; letter-spacing:-0.01em; margin-bottom:0.15em;">
      We Build More Than Homes.
    </h2>
    <h2 class="animate-on-scroll font-body font-extrabold uppercase" style="font-size:clamp(2.8rem,6vw,5.5rem); color:#C89B5A; line-height:0.95; letter-spacing:-0.01em; margin-bottom:2.5rem;">
      We Build Legacies.
    </h2>

    <!-- Gold rule -->
    <div class="animate-on-scroll mx-auto mb-8" style="width:40px; height:1px; background:#C89B5A; opacity:0.7;"></div>

    <p class="animate-on-scroll font-body font-light" style="font-size:0.85rem; color:rgba(248,248,248,0.45); max-width:380px; margin:0 auto 2.5rem; line-height:1.8;">
      Schedule your free consultation and receive a detailed quote within 5 business days.
    </p>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-5">
      <a href="/contact" class="btn-luxe-fill">Schedule Free Consultation</a>
      <a href="tel:8322058178"
        class="font-body uppercase transition-colors duration-300"
        style="font-size:10px; letter-spacing:0.18em; color:rgba(200,155,90,0.45);"
        onmouseover="this.style.color='#C89B5A'"
        onmouseout="this.style.color='rgba(200,155,90,0.45)'">
        (832) 205-8178
      </a>
    </div>

  </div>

  <!-- Diagonal bottom cut -->
  <div class="absolute bottom-0 left-0 right-0 overflow-hidden" style="height:60px;">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width:100%; height:60px; display:block;">
      <polygon points="1440,0 1440,60 0,60" fill="#050505"/>
    </svg>
  </div>
</section>
