---
// CTABanner.astro
---

<section class="relative overflow-hidden bg-[#1c1917] text-[#fffdf8] border-t border-[rgba(255,255,255,0.08)]">
  <img 
    src="/images/saadi-custom-home-exterior.jpg" 
    alt="Luxury custom residence in Memorial Houston" 
    class="absolute inset-0 h-full w-full object-cover opacity-25" 
    loading="lazy" 
  />
  <div class="absolute inset-0 bg-gradient-to-r from-[#1c1917] via-[#1c1917]/90 to-[#1c1917]/60"></div>

  <div class="relative container-main py-28 md:py-36">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[#dfc8a7]"></span>
        <p class="font-mono text-xs uppercase tracking-[0.26em] text-[#dfc8a7]">Preconstruction Consultation</p>
      </div>
      <h2 class="font-heading mt-4 text-4xl sm:text-5xl md:text-6xl font-medium leading-tight text-[#fffdf8]">
        Ready to build with one accountable team?
      </h2>
      <p class="mt-6 text-base sm:text-lg text-[#dfd7ca] leading-relaxed max-w-xl">
        Schedule a preconstruction review. We will evaluate your lot conditions, tree preservation requirements, municipal setbacks, and provide fixed-price scope parameters within five business days.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center bg-[#8c6d46] px-8 py-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254]"
        >
          Request Feasibility Consultation
        </a>
        <a 
          href="tel:+18323603804" 
          class="inline-flex items-center justify-center border border-white/20 bg-white/5 px-8 py-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-white/10"
        >
          Call (832) 360-3804
        </a>
      </div>

      <div class="mt-8 flex items-center gap-4 text-xs font-mono text-[#dfc8a7]">
        <a href="mailto:info@saadiconstructiongroup.com" class="hover:text-white transition-colors">
          info@saadiconstructiongroup.com
        </a>
        <span aria-hidden="true" class="opacity-40">·</span>
        <span>Downtown Office: 801 Travis St, Suite 2101, Houston, TX 77002</span>
      </div>
    </div>
  </div>
</section>
