---

<section class="relative min-h-[65vh] flex items-center overflow-hidden">
  <img
    src="/images/p3-exterior-front.png"
    alt="Saadi Construction Group luxury Houston home"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-black/72"></div>

  <div class="relative z-10 container-main px-6 py-24 w-full text-center">

    <div class="animate-on-scroll mb-4">
      <span class="font-script text-gold text-4xl md:text-5xl" style="font-family: 'Great Vibes', cursive; line-height: 1.3;">
        We build more than homes,
      </span>
    </div>

    <h2 class="animate-on-scroll font-heading font-light text-white tracking-widest uppercase text-4xl md:text-5xl lg:text-6xl mb-2">
      We Build
    </h2>
    <h2 class="animate-on-scroll font-heading font-light text-gold tracking-widest uppercase text-4xl md:text-5xl lg:text-6xl mb-12">
      Legacies.
    </h2>

    <p class="animate-on-scroll font-body text-sm text-white/50 max-w-md mx-auto font-light leading-relaxed mb-10">
      Schedule your free consultation and receive a detailed quote within 5 business days.
    </p>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact" class="btn-gold">Schedule Free Consultation</a>
      <a href="tel:8322058178" class="font-body text-xs tracking-[0.15em] uppercase text-white/40 hover:text-gold transition-colors duration-300">
        (832) 205-8178
      </a>
    </div>

  </div>
</section>
