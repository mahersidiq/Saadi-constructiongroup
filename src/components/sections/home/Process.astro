---
// Process.astro - Architectural & Engineering Sequence
// Detailed 7-stage Houston construction methodology with technical precision
const processStages = [
  {
    step: '01',
    title: 'Consultation, Boundary & Lot Feasibility',
    discipline: 'Preconstruction Planning',
    description: 'We evaluate property boundaries, mature tree preservation rules, municipal setback envelopes, and flood risk benchmarks (Harris County Chapter 19 & base flood elevation). Initial budget parameters and architectural goals are established before drawing a single line.',
    houstonFocus: 'Survey of protected live oaks and preliminary floodplain verification in Memorial, River Oaks, or West U.',
  },
  {
    step: '02',
    title: 'Architectural Design & Space Planning',
    discipline: 'Design Development',
    description: 'Our architectural team produces schematic floor plans, exterior elevations, and window schedules tailored to your site orientation. Sunlight angles, loggia shading, and private courtyard sightlines are resolved collaboratively with the homeowner.',
    houstonFocus: 'Alignment with neighborhood Architectural Review Committees (ROPO in River Oaks, DSC in The Woodlands).',
  },
  {
    step: '03',
    title: 'Geotechnical Soil Borings & Structural Engineering',
    discipline: 'Building Science & Code',
    description: 'Independent geotechnical engineers pull soil core samples to measure the Plasticity Index (PI) of the subgrade. Structural engineers calculate steel beam loads, column points, and design a custom stiffened post-tension foundation or drilled bell piers.',
    houstonFocus: 'Engineered specifically for expansive Gulf Coast Beaumont clay to prevent foundation settlement.',
  },
  {
    step: '04',
    title: 'City Permitting & Utility Infrastructure',
    discipline: 'Municipal Expediting',
    description: 'We submit full architectural, structural, and civil drainage plan sets directly to the City of Houston Houston Permitting Center or municipal building department. We coordinate MUD water/sewer tap applications and CenterPoint electrical service.',
    houstonFocus: 'Active management of Houston Chapter 19 drainage review and detention requirements.',
  },
  {
    step: '05',
    title: 'Foundation Pour, Framing & MEP Rough-Ins',
    discipline: 'Heavy Structural Construction',
    description: 'Following pad preparation and termite pre-treatment, post-tension cables are placed and concrete is poured with third-party cylinder break tests. Dimensional framing, engineered floor trusses, ZIP System weather barriers, and mechanical/electrical/plumbing rough-ins follow with strict quality inspection.',
    houstonFocus: 'Continuous air-water barrier sealing and high-efficiency multi-stage HVAC zoning with dedicated whole-home dehumidification.',
  },
  {
    step: '06',
    title: 'Architectural Enclosure & Interior Millwork',
    discipline: 'Artisan Finish Craft',
    description: 'Full-bed Texas limestone masonry, standing-seam metal roofing, and high-performance clad windows weather-tight the home. Inside, Level 5 drywall finishes, wide-plank French white oak flooring, custom inset cabinetry, bookmatched stone slabs, and architectural lighting are installed.',
    houstonFocus: 'Moisture-cured adhesive flooring protocols and climate-controlled conditioning during millwork installation.',
  },
  {
    step: '07',
    title: 'Commissioning, Quality Audit & Handover',
    discipline: 'Certification & Closeout',
    description: 'Every mechanical system, smart control, and plumbing fixture undergoes rigorous commissioning. We perform thermal imaging envelope audits, duct blast tests, and create comprehensive digital as-built documentation for the homeowner prior to final walkthrough.',
    houstonFocus: 'Issuance of Certificate of Occupancy, transfer of third-party structural warranties, and homeowner maintenance guide.',
  },
];
---

<section id="process" class="bg-[#1c1917] text-[#fffdf8] py-28 md:py-36 border-t border-[rgba(255,255,255,0.08)]">
  <div class="container-main">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[#dfc8a7]"></span>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[#dfc8a7]">Houston Engineering Methodology</p>
      </div>
      <h2 class="font-heading mt-4 text-4xl font-medium sm:text-5xl md:text-6xl text-[#fffdf8]">
        From Soil Borings to Move-In: The Design-Build Sequence.
      </h2>
      <p class="mt-6 text-base text-[#dfd7ca] leading-relaxed max-w-2xl">
        Every luxury custom home we build in Greater Houston follows an uncompromised seven-stage engineering protocol, eliminating delays and ensuring structural permanence.
      </p>
    </div>

    <div class="mt-20 border-t border-[rgba(255,255,255,0.1)]">
      {processStages.map((stage) => (
        <div class="group border-b border-[rgba(255,255,255,0.08)] py-10 transition-colors hover:bg-white/[0.02]">
          <div class="grid gap-6 md:grid-cols-12 lg:items-start">
            {/* Step Number */}
            <div class="md:col-span-2">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#dfc8a7]">Phase</span>
              <p class="font-heading text-4xl font-light text-[#dfc8a7] md:text-5xl mt-1">{stage.step}</p>
            </div>

            {/* Title & Discipline */}
            <div class="md:col-span-4">
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#dfc8a7]/70 block">{stage.discipline}</span>
              <h3 class="font-heading text-2xl sm:text-3xl font-medium text-[#fffdf8] mt-1.5 leading-snug">
                {stage.title}
              </h3>
            </div>

            {/* Description & Houston Specificity */}
            <div class="md:col-span-6 space-y-3">
              <p class="text-sm sm:text-base leading-relaxed text-[#dfd7ca]">
                {stage.description}
              </p>
              <div class="border-l border-[#8c6d46] pl-4 py-1 text-xs font-mono text-[#dfc8a7]/85">
                <span class="text-[#dfc8a7] font-semibold">Houston Factor:</span> {stage.houstonFocus}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Process Action Footnote */}
    <div class="mt-14 flex flex-col sm:flex-row items-center justify-between gap-6 border border-[rgba(255,255,255,0.1)] bg-black/25 p-8 backdrop-blur">
      <div>
        <h4 class="font-heading text-xl text-[#fffdf8]">Ready to evaluate your lot before buying?</h4>
        <p class="mt-1 text-xs text-[#dfd7ca]">We provide free preconstruction feasibility assessments across Memorial, River Oaks, West U, and The Woodlands.</p>
      </div>
      <a 
        href="/contact" 
        class="inline-flex items-center justify-center bg-[#8c6d46] px-6 py-3 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254] shrink-0"
      >
        Request Feasibility Review
      </a>
    </div>
  </div>
</section>
