---
const steps = [
  {
    title: 'Consultation & Quote',
    text: 'Site visit, design discussion, and a detailed fixed-price quote within 5 business days.',
  },
  {
    title: 'Plans, Engineering & Permits',
    text: 'Architectural drawings, structural engineering, and city permit submission — all handled in-house.',
  },
  {
    title: 'Construction',
    text: 'Weekly owner updates, milestone-based billing, and full trade management from groundbreak to close-in.',
  },
  {
    title: 'Final Walkthrough',
    text: 'Full punch walkthrough, photo documentation of every system, and warranty packet at handoff.',
  },
];
---

<section class="bg-cream-dark py-24 md:py-36 px-6">
  <div class="container-main">

    <div class="max-w-xl mb-16">
      <h2 class="animate-on-scroll font-heading font-light text-warm-black leading-tight mb-6" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
        How We Build<br/><em class="text-gold not-italic">Your Home</em>
      </h2>
      <p class="animate-on-scroll font-body text-sm text-warm-mid font-light leading-relaxed">
        A clear, proven process — from your first conversation to the day you move in.
      </p>
    </div>

    <!-- Desktop: horizontal -->
    <div class="hidden md:grid grid-cols-4 gap-8 border-t border-stone pt-14 relative">
      {steps.map((step, i) => (
        <div class="animate-on-scroll" style={`transition-delay: ${i * 0.12}s`}>
          <div class="font-heading text-6xl font-light text-gold/20 leading-none mb-6 select-none">{i + 1}</div>
          <h3 class="font-heading text-xl font-light text-warm-black mb-3">{step.title}</h3>
          <p class="font-body text-sm text-warm-mid font-light leading-relaxed">{step.text}</p>
        </div>
      ))}
    </div>

    <!-- Mobile: vertical -->
    <div class="md:hidden space-y-10 border-t border-stone pt-12">
      {steps.map((step, i) => (
        <div class="animate-on-scroll flex gap-8">
          <div class="font-heading text-4xl font-light text-gold/30 leading-none flex-shrink-0 select-none pt-1">{i + 1}</div>
          <div>
            <h3 class="font-heading text-xl font-light text-warm-black mb-2">{step.title}</h3>
            <p class="font-body text-sm text-warm-mid font-light leading-relaxed">{step.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="animate-on-scroll mt-14">
      <a href="/contact" class="btn-primary">Start Your Project</a>
    </div>
  </div>
</section>
