---
const steps = [
  {
    title: 'Consultation & Quote',
    text: 'Site visit, design discussion, and a detailed fixed-price quote within 5 business days.',
  },
  {
    title: 'Plans, Engineering & Permits',
    text: 'Our team produces architectural drawings, coordinates structural engineering, and submits for city permits — all included.',
  },
  {
    title: 'Construction',
    text: 'Weekly owner updates, milestone-based billing, and full trade management from groundbreak to close-in.',
  },
  {
    title: 'Final Walkthrough & Handoff',
    text: 'Full punch walkthrough with owner, photo documentation of every system, and warranty packet at handoff.',
  },
];
---

<section class="grain relative" style="background:#111111; padding:7rem 0;">
  <div class="container-main px-6">

    <div class="max-w-xl mb-16">
      <h2 class="animate-on-scroll font-heading font-light" style="font-size:clamp(2.4rem,4.5vw,4rem); color:#F5F5F5; line-height:1.1;">
        How We Build Your Home
      </h2>
      <div class="mt-6" style="width:40px; height:1px; background:#C89B5A; opacity:0.7;"></div>
    </div>

    <!-- Desktop timeline -->
    <div class="hidden md:grid grid-cols-4 gap-8 relative">
      <!-- Connecting line -->
      <div class="absolute top-8 left-[12.5%] right-[12.5%]" style="height:1px; background:linear-gradient(90deg, transparent, rgba(200,155,90,0.3), transparent);"></div>

      {steps.map((step, i) => (
        <div class="animate-on-scroll flex flex-col items-center text-center group" style={`transition-delay:${i * 0.1}s;`}>
          <!-- Number ring -->
          <div class="relative z-10 flex items-center justify-center mb-8 transition-all duration-400 group-hover:scale-110"
            style="width:64px; height:64px; border-radius:50%; border:1px solid rgba(200,155,90,0.35); background:#111111; box-shadow: group-hover ? '0 0 30px rgba(200,155,90,0.15)' : 'none';">
            <span class="font-body font-semibold" style="font-size:1.2rem; color:#C89B5A;">{i + 1}</span>
          </div>
          <div class="mb-4" style="width:20px; height:1px; background:rgba(200,155,90,0.4);"></div>
          <h3 class="font-heading font-light mb-3 transition-colors duration-300 group-hover:text-[#C89B5A]"
            style="font-size:1.1rem; color:#F5F5F5; letter-spacing:0.01em;">
            {step.title}
          </h3>
          <p class="font-body font-light leading-relaxed" style="font-size:0.82rem; color:#666666; line-height:1.7;">
            {step.text}
          </p>
        </div>
      ))}
    </div>

    <!-- Mobile timeline -->
    <div class="md:hidden space-y-0" style="border-top:1px solid rgba(200,155,90,0.15);">
      {steps.map((step, i) => (
        <div class="animate-on-scroll flex gap-7 py-8" style="border-bottom:1px solid rgba(200,155,90,0.1);">
          <div class="flex-shrink-0 flex items-center justify-center"
            style="width:48px; height:48px; border-radius:50%; border:1px solid rgba(200,155,90,0.35); background:#0D0D0D; min-width:48px;">
            <span class="font-heading font-light" style="font-size:1.2rem; color:#C89B5A;">{i + 1}</span>
          </div>
          <div class="pt-1">
            <h3 class="font-heading font-light mb-2" style="font-size:1.2rem; color:#F5F5F5;">{step.title}</h3>
            <p class="font-body font-light leading-relaxed" style="font-size:0.85rem; color:#666666; line-height:1.7;">{step.text}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
