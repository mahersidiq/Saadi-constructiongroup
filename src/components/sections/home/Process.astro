---
const steps = [
  ['01', 'Consultation & Site Evaluation', 'Lot conditions, goals, budget, timeline, and the current stage of your project are reviewed before scope is defined.'],
  ['02', 'Plans, Engineering & Permits', 'Architectural plans, structural engineering, soil considerations, and jurisdiction requirements are coordinated into a permit-ready path.'],
  ['03', 'Preconstruction & Fixed Scope', 'Selections, allowances, trade pricing, milestone billing, and schedule expectations are clarified before construction begins.'],
  ['04', 'Construction', 'Trades are coordinated around the approved plans with owner updates, inspections, and field quality control at key milestones.'],
  ['05', 'Selections, Finishes & Quality Control', 'Finish details are tracked against the scope so craftsmanship, schedule, and budget discipline stay connected.'],
  ['06', 'Final Walkthrough & Handoff', 'Punch list, closeout documentation, warranty information, and final handoff complete the construction journey.'],
];
---
<section class="dark-section">
  <div class="container-main section-padding relative">
    <div class="mb-16 max-w-3xl animate-on-scroll">
      <p class="eyebrow">Controlled Builder Timeline</p>
      <h2 class="display-heading mt-4 text-4xl text-[#fff8ed] md:text-6xl">A clear path from first consultation to final walkthrough.</h2>
    </div>
    <div class="border-t border-[#e7c797]/18">
      {steps.map(([num, title, text]) => (
        <div class="animate-on-scroll group grid gap-5 border-b border-[#e7c797]/14 py-9 transition-colors hover:bg-[#fff8ed]/[.035] md:grid-cols-[120px_.8fr_1.2fr] md:items-start md:px-5">
          <p class="font-heading text-5xl leading-none text-[#b88a4a]">{num}</p>
          <h3 class="font-heading text-3xl leading-tight text-[#fff8ed]">{title}</h3>
          <p class="leading-8 text-[#fff8ed]/70">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
