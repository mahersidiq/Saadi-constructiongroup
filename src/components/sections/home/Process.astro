---
const steps = [
  {
    title: 'Consultation & Quote',
    text: 'Site visit, design discussion, and a detailed fixed-price quote within 5 business days.',
  },
  {
    title: 'Plans, Engineering & Permits',
    text: 'Our team produces architectural drawings, coordinates structural engineering, and submits for city permits — all included.',
  },
  {
    title: 'Construction',
    text: 'Weekly owner updates, milestone-based billing, and full trade management from groundbreak to close-in.',
  },
  {
    title: 'Final Walkthrough & Handoff',
    text: 'Full punch walkthrough with owner, photo documentation of every system, and warranty packet at handoff.',
  },
];
---

<section class="section-padding bg-charcoal relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 100%, rgba(201,149,42,0.03) 0%, transparent 60%)"></div>

  <div class="container-main px-6 relative z-10">

    <!-- Header -->
    <div class="text-center mb-20">
      <div class="animate-on-scroll mb-4">
        <span class="section-label">Our Process</span>
      </div>
      <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl lg:text-6xl leading-tight">
        How We Build <span class="italic text-gold">Your Home</span>
      </h2>
      <div class="animate-on-scroll gold-line mt-8"></div>
    </div>

    <!-- Desktop: horizontal timeline -->
    <div class="hidden md:block relative">
      <!-- Connecting line -->
      <div class="absolute top-10 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

      <div class="grid grid-cols-4 gap-8">
        {steps.map((step, i) => (
          <div class="animate-on-scroll relative flex flex-col items-center text-center group" style={`transition-delay: ${i * 0.1}s`}>

            <!-- Step circle -->
            <div class="relative z-10 w-20 h-20 flex items-center justify-center mb-8 group">
              <div class="absolute inset-0 border border-gold/20 rounded-full group-hover:border-gold/60 transition-all duration-500"></div>
              <div class="absolute inset-2 bg-dark-card rounded-full"></div>
              <span class="relative font-heading text-3xl font-light text-gold z-10 leading-none">
                {i + 1}
              </span>
            </div>

            <div class="w-8 h-px bg-gold/30 mb-6 group-hover:bg-gold/60 transition-colors duration-500"></div>

            <h3 class="font-heading text-lg md:text-xl font-light text-white mb-3 tracking-wide">
              {step.title}
            </h3>
            <p class="font-body text-xs text-white/40 leading-relaxed font-light">
              {step.text}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: vertical timeline -->
    <div class="md:hidden space-y-0">
      {steps.map((step, i) => (
        <div class="animate-on-scroll flex gap-6 relative pb-12 last:pb-0">
          <!-- Vertical line -->
          {i < steps.length - 1 && (
            <div class="absolute left-7 top-14 bottom-0 w-px bg-gradient-to-b from-gold/30 to-transparent"></div>
          )}

          <!-- Step circle -->
          <div class="flex-shrink-0 w-14 h-14 flex items-center justify-center relative z-10">
            <div class="absolute inset-0 border border-gold/30 rounded-full"></div>
            <div class="absolute inset-1 bg-dark-card rounded-full"></div>
            <span class="relative font-heading text-xl font-light text-gold z-10">{i + 1}</span>
          </div>

          <!-- Content -->
          <div class="pt-2">
            <div class="w-8 h-px bg-gold/30 mb-4"></div>
            <h3 class="font-heading text-xl font-light text-white mb-2">{step.title}</h3>
            <p class="font-body text-sm text-white/40 leading-relaxed font-light">{step.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="animate-on-scroll text-center mt-16">
      <a href="/contact" class="btn-primary">Start Your Project</a>
    </div>
  </div>
</section>
