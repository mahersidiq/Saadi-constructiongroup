---
---

<section class="relative min-h-screen flex items-end overflow-hidden">
  <!-- Background Image -->
  <img
    src="/images/p8-exterior-front.png"
    alt="Houston custom home builder — Saadi Construction Group luxury modern home"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Warm dark overlay — heavier at bottom where text lives -->
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>
  <!-- Warm left-side gradient so text pops -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/30 to-transparent"></div>

  <!-- Content — sits at the bottom of the viewport -->
  <div class="relative z-10 w-full container-main px-6 lg:px-8 pb-24 md:pb-32">
    <div class="max-w-3xl">

      <!-- Thin gold rule -->
      <div class="w-10 h-px bg-gold mb-10 animate-fade-in"></div>

      <!-- Main Headline -->
      <h1 class="animate-fade-in font-heading font-light text-white leading-[1.08]">
        <span class="block text-5xl md:text-6xl lg:text-[5.5rem] xl:text-[6.5rem]">Ready to Build</span>
        <span class="block text-5xl md:text-6xl lg:text-[5.5rem] xl:text-[6.5rem] text-gold italic">Something</span>
        <span class="block text-5xl md:text-6xl lg:text-[5.5rem] xl:text-[6.5rem]">Extraordinary?</span>
      </h1>

      <!-- Body -->
      <p class="animate-fade-in-up-delay mt-8 text-base md:text-lg text-white/55 max-w-lg font-body font-light leading-relaxed">
        If you're ready to bring your vision to life, we're here to help.
        Plans. Engineering. Permits. Construction — one contract, one team.
      </p>

      <!-- CTAs -->
      <div class="animate-fade-in-up-delay-2 mt-10 flex flex-wrap items-center gap-4">
        <a href="/contact" class="inline-flex items-center px-8 py-4 bg-gold text-white font-body text-xs tracking-[0.2em] uppercase font-semibold hover:bg-gold-light hover:text-charcoal transition-all duration-300">
          Schedule Free Consultation
        </a>
        <a href="/projects" class="inline-flex items-center px-8 py-4 border border-white/30 text-white font-body text-xs tracking-[0.2em] uppercase font-semibold hover:border-white hover:bg-white/5 transition-all duration-300">
          View Our Work
        </a>
      </div>

      <!-- Phone -->
      <p class="animate-fade-in-up-delay-2 mt-8 font-body text-xs text-white/35 tracking-[0.12em]">
        CALL / TEXT &nbsp;
        <a href="tel:8322058178" class="text-gold hover:text-gold-light transition-colors font-medium">
          (832) 205-8178
        </a>
        <span class="text-white/20 mx-3">|</span>
        <span>Houston, TX &amp; Surrounding Areas</span>
      </p>
    </div>
  </div>

  <!-- Scroll indicator — right side -->
  <div class="absolute right-8 bottom-12 hidden md:flex flex-col items-center gap-3 animate-fade-in-up-delay-3">
    <div class="h-12 w-px bg-gradient-to-b from-transparent to-white/20"></div>
    <span class="font-body text-[9px] tracking-[0.3em] text-white/25 uppercase" style="writing-mode: vertical-rl;">Scroll</span>
  </div>
</section>
