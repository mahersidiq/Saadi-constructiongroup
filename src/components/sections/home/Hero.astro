---
// Hero.astro - Architectural Stillness Hero
// High-performance architectural photography presentation with optimal Core Web Vitals
---

<section class="relative min-h-[92vh] lg:min-h-screen overflow-hidden bg-[#1c1917] text-[#fff8ed] flex items-center">
  {/* High-Resolution Architectural Photography (LCP Optimized) */}
  <img 
    src="/images/saadi-custom-home-exterior.jpg" 
    alt="Architectural modern custom residence in Memorial Houston built by Saadi Construction Group" 
    class="hero-photo absolute inset-0 h-full w-full object-cover object-center scale-[1.02] transition-transform duration-1000" 
    fetchpriority="high"
    loading="eager"
  />

  {/* Contrast Scrims ensuring WCAG AA (4.5:1+) readability over photography */}
  <div class="absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/55 to-black/30 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-radial-vignette pointer-events-none" aria-hidden="true"></div>

  {/* Content Container */}
  <div class="relative z-10 container-main pt-32 pb-20 md:py-36 w-full">
    <div class="max-w-4xl">
      {/* Editorial Kicker */}
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[#dfc8a7]"></span>
        <p class="font-mono text-xs uppercase tracking-[0.26em] text-[#dfc8a7]">
          Houston Custom Home Builder &amp; Architectural Design-Build
        </p>
      </div>

      {/* Primary Headline */}
      <h1 class="font-heading mt-6 text-4xl sm:text-6xl lg:text-7xl xl:text-[5rem] font-medium leading-[1.02] tracking-tight text-[#fffdf8]">
        Architectural Precision.<br />
        Built Under One Accountable Contract.
      </h1>

      {/* Grounded Sub-paragraph */}
      <p class="hero-description mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[#dfd7ca]">
        Saadi Construction Group designs and builds luxury custom homes in Houston. We handle your plans, engineering, permits, and construction under one contract, in Memorial, River Oaks, West University Place, and The Woodlands.
      </p>

      {/* Unboxed Metadata (Zero-Pill Discipline) */}
      <div class="mt-8 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono uppercase tracking-[0.18em] text-[#dfc8a7]/90" aria-label="Core Capabilities">
        <span>Architectural Plans</span>
        <span aria-hidden="true" class="text-[#dfc8a7]/40">/</span>
        <span>Structural Engineering</span>
        <span aria-hidden="true" class="text-[#dfc8a7]/40">/</span>
        <span>City of Houston Permits</span>
        <span aria-hidden="true" class="text-[#dfc8a7]/40">/</span>
        <span>Turnkey Construction</span>
      </div>

      {/* Action Buttons */}
      <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center bg-[#8c6d46] px-8 py-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254] shadow-lg shadow-black/20"
        >
          Schedule Feasibility Consultation
        </a>
        <a 
          href="/projects" 
          class="inline-flex items-center justify-center border border-[rgba(255,253,248,0.25)] bg-black/20 px-8 py-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] backdrop-blur transition hover:bg-white/10"
        >
          Explore Selected Works
        </a>
      </div>

      {/* Direct Verified Contact Marker */}
      <div class="mt-8 flex flex-wrap items-center gap-6 text-xs font-mono text-[#dfc8a7]">
        <a href="tel:+18323603804" class="hover:text-[#fffdf8] transition-colors tracking-wider">
          Direct Line: (832) 360-3804
        </a>
        <span aria-hidden="true" class="opacity-30">|</span>
        <span class="tracking-wider">Office: 801 Travis St, Suite 2101, Houston</span>
      </div>
    </div>
  </div>

  {/* Subtle Lower Gradient Transition */}
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#fbf9f5] to-transparent pointer-events-none" aria-hidden="true"></div>
</section>

<style>
  .bg-radial-vignette {
    background: radial-gradient(ellipse at center, transparent 40%, rgba(20, 18, 16, 0.45) 100%);
  }
</style>
