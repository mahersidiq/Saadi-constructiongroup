---
---

<section class="relative h-screen min-h-[700px] flex overflow-hidden" style="background:#050505;">

  <!-- Full-bleed cinematic image -->
  <img
    src="/images/p8-exterior-front.png"
    alt="Houston custom home builder — Saadi Construction Group luxury modern home"
    class="absolute inset-0 w-full h-full object-cover animate-fade-in"
    style="transform-origin:center; animation-duration:1.4s;"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Layered dark overlays — heavier on left for text legibility, diagonal edge on right -->
  <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(5,5,5,0.92) 0%, rgba(5,5,5,0.82) 42%, rgba(5,5,5,0.45) 65%, rgba(5,5,5,0.15) 100%);"></div>
  <!-- Bottom fade -->
  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(5,5,5,0.8) 0%, transparent 40%);"></div>
  <!-- Subtle gold glow accent top-left -->
  <div class="absolute top-0 left-0 w-64 h-64 pointer-events-none" style="background: radial-gradient(ellipse at top left, rgba(200,155,90,0.04), transparent 70%);"></div>

  <!-- ─── Left content panel ─── -->
  <div class="relative z-10 flex flex-col justify-end w-full container-main px-6 lg:px-8 pb-20 md:pb-28">
    <div class="max-w-2xl">

      <!-- Gold rule -->
      <div class="animate-fade-in w-10 h-px mb-10" style="background:#C89B5A;"></div>

      <!-- Headline — keep existing wording -->
      <h1 class="animate-fade-in font-heading font-light leading-[1.05]" style="font-size: clamp(3rem, 7vw, 6.5rem); color:#F5F5F5; letter-spacing:-0.01em;">
        Houston's One-Stop<br/>
        <em style="color:#C89B5A; font-style:italic;">Custom Home Builder</em>
      </h1>

      <!-- Sub-headline — original text -->
      <p class="animate-fade-in-up-delay mt-6 font-body font-light leading-relaxed" style="font-size:1rem; color:#B8B8B8; max-width:480px; letter-spacing:0.01em;">
        Plans. Engineering. Permits. Construction. One contract, one team — we handle everything from blank lot to move-in ready.
      </p>

      <!-- CTAs -->
      <div class="animate-fade-in-up-delay-2 mt-10 flex flex-wrap items-center gap-4">
        <a href="/contact" class="btn-luxe-fill">Request a Quote</a>
        <a href="/services" class="btn-ghost">Our Services</a>
      </div>

      <!-- Phone -->
      <p class="animate-fade-in-up-delay-2 mt-7 font-body" style="font-size:11px; letter-spacing:0.14em; color:#666666;">
        Call us directly:&nbsp;
        <a href="tel:8322058178" style="color:#C89B5A;" class="hover:text-[#D4AF6E] transition-colors">(832) 205-8178</a>
      </p>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-10 right-10 hidden md:flex flex-col items-center gap-3 animate-fade-in-up-delay-3">
    <span class="font-body uppercase" style="font-size:9px; letter-spacing:0.3em; color:#666666; writing-mode:vertical-rl;">Scroll</span>
    <div class="h-12 w-px" style="background: linear-gradient(to bottom, rgba(200,155,90,0.4), transparent);"></div>
  </div>

  <!-- Diagonal bottom cut -->
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="height:60px; overflow:hidden;">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width:100%; height:100%;" xmlns="http://www.w3.org/2000/svg">
      <polygon points="0,60 1440,0 1440,60" fill="#050505"/>
    </svg>
  </div>
</section>
