---
const { faqs = [], heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="bg-cream-dark py-24 md:py-36 px-6 border-t border-stone">
  <div class="container-main">
    <div class="grid md:grid-cols-12 gap-12 md:gap-20">

      <!-- Left: Heading -->
      <div class="md:col-span-4">
        <h2 class="animate-on-scroll font-heading font-light text-warm-black leading-tight sticky top-32" style="font-size: clamp(2rem, 4vw, 3.2rem);">
          {heading}
        </h2>
      </div>

      <!-- Right: Questions -->
      <div class="md:col-span-8">
        <div class="divide-y divide-stone">
          {faqs.map((faq) => (
            <details class="animate-on-scroll group py-6 cursor-pointer">
              <summary class="flex items-start justify-between gap-6 list-none">
                <span class="font-heading text-lg md:text-xl font-light text-warm-dark group-open:text-warm-black transition-colors duration-200 leading-snug pr-4">
                  {faq.question}
                </span>
                <span class="flex-shrink-0 mt-1 font-heading text-2xl font-light text-gold/50 group-open:text-gold leading-none select-none transition-colors duration-200">
                  +
                </span>
              </summary>
              <p class="mt-4 font-body text-sm text-warm-mid leading-relaxed font-light pr-10">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>

        <div class="animate-on-scroll mt-12">
          <a href="/contact" class="btn-outline">Ask Us Directly</a>
        </div>
      </div>

    </div>
  </div>
</section>
