---
const { faqs = [], heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="dark-section relative py-24 md:py-32">
  <div class="container-main">
    <div class="grid gap-12 md:grid-cols-12 md:gap-20">
      <div class="md:col-span-4">
        <p class="eyebrow animate-on-scroll">Details</p>
        <h2 class="animate-on-scroll display-heading sticky top-32 mt-4 text-4xl text-[#fff8ed] md:text-6xl">{heading}</h2>
        <div class="gold-rule mt-7"></div>
      </div>
      <div class="md:col-span-8">
        <div class="border-t border-[#e7c797]/18">
          {faqs.map((faq) => (
            <details class="animate-on-scroll group cursor-pointer border-b border-[#e7c797]/14 py-7">
              <summary class="flex list-none items-start justify-between gap-6">
                <span class="pr-4 font-heading text-2xl leading-snug text-[#fff8ed] transition-colors duration-300 group-open:text-[#e7c797]">
                  {faq.question}
                </span>
                <span class="mt-0.5 flex-shrink-0 select-none font-heading text-3xl leading-none text-[#e7c797]/58 transition-transform duration-300 group-open:rotate-45 group-open:text-[#e7c797]">
                  +
                </span>
              </summary>
              <p class="mt-5 max-w-3xl pr-10 text-sm leading-8 text-[#fff8ed]/68">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
        <div class="animate-on-scroll mt-12">
          <a href="/contact" class="btn-ghost">Ask Us Directly</a>
        </div>
      </div>
    </div>
  </div>
</section>
