---
const { faqs = [], heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="section-padding bg-obsidian relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 0%, rgba(201,149,42,0.03) 0%, transparent 50%)"></div>

  <div class="container-main px-6 relative z-10">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-14">
        <div class="animate-on-scroll mb-4">
          <span class="section-label">Common Questions</span>
        </div>
        <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl leading-tight">
          {heading}
        </h2>
        <div class="animate-on-scroll gold-line mt-8"></div>
      </div>

      <!-- FAQ items -->
      <div class="space-y-0 divide-y divide-gold/10">
        {faqs.map((faq) => (
          <details class="animate-on-scroll group py-7 cursor-pointer">
            <summary class="flex items-start justify-between gap-6 list-none">
              <span class="font-heading text-lg md:text-xl font-light text-white/80 group-open:text-white transition-colors duration-300 leading-snug">
                {faq.question}
              </span>
              <span class="flex-shrink-0 mt-1 w-6 h-6 flex items-center justify-center border border-gold/20 group-open:border-gold/60 group-hover:border-gold/40 transition-colors duration-300">
                <svg
                  class="w-3 h-3 text-gold/60 group-open:text-gold transition-all duration-200 group-open:rotate-45"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </span>
            </summary>
            <p class="mt-5 font-body text-sm text-white/40 leading-relaxed font-light pr-12">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>

      <!-- Contact CTA -->
      <div class="animate-on-scroll mt-14 text-center">
        <p class="font-body text-sm text-white/30 mb-6 tracking-wide">
          Have more questions? We're happy to answer them directly.
        </p>
        <a href="/contact" class="btn-outline-gold">
          Get In Touch
        </a>
      </div>
    </div>
  </div>
</section>
