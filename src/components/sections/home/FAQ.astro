---
const { faqs = [], heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="bg-[#1c1917] text-[#fffdf8] py-24 md:py-32 border-t border-[rgba(255,253,248,0.08)]">
  <div class="container-main">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7] mb-3">
          Architectural Advisory
        </p>
        <h2 class="font-heading sticky top-32 text-4xl md:text-5xl font-medium text-[#fffdf8] leading-[1.08]">
          {heading}
        </h2>
        <div class="mt-6 h-px w-14 bg-[#8c6d46]"></div>
      </div>
      <div class="md:col-span-8">
        <div class="border-t border-[rgba(255,253,248,0.12)]">
          {faqs.map((faq) => (
            <details class="group cursor-pointer border-b border-[rgba(255,253,248,0.12)] py-7">
              <summary class="flex list-none items-start justify-between gap-6">
                <span class="pr-4 font-heading text-2xl font-medium leading-snug text-[#fffdf8] transition-colors duration-200 group-open:text-[#dfc8a7]">
                  {faq.question}
                </span>
                <span class="mt-0.5 flex-shrink-0 select-none font-sans text-2xl font-light leading-none text-[#dfc8a7]/70 transition-transform duration-200 group-open:rotate-45 group-open:text-[#dfc8a7]">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-3xl pr-8 font-sans text-sm leading-7 text-[#dfd7ca]/80">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
        <div class="mt-10">
          <a
            href="/contact"
            class="inline-flex items-center justify-center border border-[rgba(255,253,248,0.3)] px-7 py-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:border-[#dfc8a7] hover:bg-[#8c6d46]"
          >
            Request Direct Principal Advisory →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
