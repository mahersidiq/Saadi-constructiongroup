---
const { faqs = [], heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="grain relative" style="background:#111111; padding:7rem 0;">
  <div class="container-main px-6">
    <div class="grid md:grid-cols-12 gap-12 md:gap-20">

      <!-- Left: Sticky heading -->
      <div class="md:col-span-4">
        <h2 class="animate-on-scroll font-heading font-light sticky top-32" style="font-size:clamp(2rem,4vw,3.2rem); color:#F5F5F5; line-height:1.1;">
          {heading}
        </h2>
        <div class="mt-6" style="width:40px; height:1px; background:#C89B5A; opacity:0.7;"></div>
      </div>

      <!-- Right: Accordion -->
      <div class="md:col-span-8">
        <div style="border-top:1px solid rgba(200,155,90,0.15);">
          {faqs.map((faq) => (
            <details class="animate-on-scroll group py-6 cursor-pointer" style="border-bottom:1px solid rgba(200,155,90,0.1);">
              <summary class="flex items-start justify-between gap-6 list-none">
                <span class="font-heading font-light leading-snug pr-4 transition-colors duration-300 group-open:text-[#C89B5A]"
                  style="font-size:1.15rem; color:#F5F5F5;">
                  {faq.question}
                </span>
                <span class="flex-shrink-0 mt-0.5 font-heading font-light leading-none select-none transition-colors duration-300 group-open:text-[#C89B5A]"
                  style="font-size:1.6rem; color:rgba(200,155,90,0.4);">
                  +
                </span>
              </summary>
              <p class="mt-5 font-body font-light leading-relaxed pr-10" style="font-size:0.85rem; color:#666666; line-height:1.8;">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>

        <div class="animate-on-scroll mt-12">
          <a href="/contact" class="btn-luxe">Ask Us Directly</a>
        </div>
      </div>

    </div>
  </div>
</section>
