---
import { allServices } from '@/data/services';

const icons: Record<string, string> = {
  'custom-home-design-build': `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />`,
  'luxury-custom-homes': `<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />`,
  'new-home-construction': `<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  'home-additions-expansions': `<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />`,
  'plans-permits-engineering': `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />`,
  'construction-management': `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />`,
};
---

<section class="section-padding bg-charcoal relative overflow-hidden">
  <!-- Subtle texture -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 20% 80%, rgba(201,149,42,0.03) 0%, transparent 50%)"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>

  <div class="container-main px-6 relative z-10">

    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="animate-on-scroll mb-4">
        <span class="section-label">What We Build</span>
      </div>
      <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl lg:text-6xl leading-tight">
        Custom Home Builder <span class="italic text-gold">Services</span>
      </h2>
      <div class="animate-on-scroll gold-line mt-8"></div>
      <p class="animate-on-scroll mt-6 font-body text-sm text-white/40 max-w-xl mx-auto font-light tracking-wide leading-relaxed">
        Every service includes plan coordination, permitting, and construction — handled by one team under one contract.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gold/10">
      {allServices.map((service) => (
        <a
          href={`/services/${service.slug}`}
          class="animate-on-scroll group relative flex flex-col bg-charcoal p-8 md:p-10 hover:bg-dark-card transition-all duration-500 overflow-hidden"
        >
          <!-- Gold corner accent on hover -->
          <div class="absolute top-0 left-0 w-0 h-px bg-gold transition-all duration-500 group-hover:w-full"></div>

          <div class="flex items-center justify-between mb-8">
            <svg class="w-6 h-6 text-gold/60 group-hover:text-gold transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2" set:html={icons[service.slug]} />
            <span class="font-body text-[9px] tracking-[0.2em] uppercase text-white/20 group-hover:text-gold/40 transition-colors duration-300">
              {service.slug === 'construction-management' ? 'Management' : service.category}
            </span>
          </div>

          <h3 class="font-heading text-xl md:text-2xl font-light text-white/80 group-hover:text-white transition-colors duration-300 mb-4 leading-snug">
            {service.name}
          </h3>

          <p class="font-body text-xs text-white/30 leading-relaxed font-light flex-1 group-hover:text-white/50 transition-colors duration-300">
            {service.description}
          </p>

          <div class="mt-6 flex items-center gap-2 text-gold/0 group-hover:text-gold transition-all duration-300">
            <span class="font-body text-[10px] tracking-[0.2em] uppercase font-medium">Learn More</span>
            <svg class="w-3.5 h-3.5 translate-x-0 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="animate-on-scroll text-center mt-12">
      <a href="/services" class="btn-outline-gold">
        View All Services
      </a>
    </div>
  </div>
</section>
