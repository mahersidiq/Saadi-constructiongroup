---
import { allServices } from '@/data/services';
---

<section class="bg-cream-dark py-24 md:py-36 px-6">
  <div class="container-main">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-16">
      <h2 class="animate-on-scroll font-heading font-light text-warm-black leading-tight" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
        What We Build
      </h2>
      <p class="animate-on-scroll font-body text-sm text-warm-mid font-light max-w-sm leading-relaxed">
        Every service includes plan coordination, permitting, and construction under one contract.
      </p>
    </div>

    <!-- Service list — editorial, not cards -->
    <div class="border-t border-stone">
      {allServices.map((service) => (
        <a
          href={`/services/${service.slug}`}
          class="animate-on-scroll group flex items-center justify-between py-7 border-b border-stone hover:border-gold/40 transition-colors duration-300"
        >
          <div class="flex items-baseline gap-6 md:gap-10">
            <span class="font-body text-xs text-warm-light font-light tracking-[0.15em] uppercase hidden md:block w-24 flex-shrink-0">
              {service.slug === 'construction-management' ? 'Management' : service.category}
            </span>
            <h3 class="font-heading text-xl md:text-2xl font-light text-warm-dark group-hover:text-warm-black transition-colors duration-300" style="letter-spacing: 0.01em;">
              {service.name}
            </h3>
          </div>
          <div class="flex items-center gap-3 text-warm-light group-hover:text-gold transition-colors duration-300 flex-shrink-0">
            <span class="font-body text-xs tracking-[0.15em] uppercase hidden sm:block">Explore</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
