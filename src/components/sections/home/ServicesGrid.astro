---
import { allServices } from '@/data/services';
const bestFor = {
  'custom-home-design-build': 'Best for clients who want one builder responsible for design coordination and construction.',
  'luxury-custom-homes': 'Best for high-spec homes with detailed finishes, selections, and field control.',
  'new-home-construction': 'Best for ground-up builds on your lot across Greater Houston.',
  'home-additions-expansions': 'Best for major expansions that require structural and permit coordination.',
  'plans-permits-engineering': 'Best for turning concepts into permit-ready construction documents.',
  'construction-management': 'Best for owner-side oversight, scope discipline, and quality control.',
};
---
<section class="stone-section">
  <div class="container-main section-padding">
    <div class="mb-14 grid gap-6 md:grid-cols-[.9fr_1fr] md:items-end">
      <div class="max-w-3xl animate-on-scroll">
        <p class="eyebrow">Service Pillars</p>
        <h2 class="display-heading mt-4 text-4xl md:text-6xl">Residential building services with one accountable path.</h2>
      </div>
      <p class="body-large animate-on-scroll md:pb-2">Each service is framed as part of a complete builder-led path, not a disconnected handoff between vendors.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {allServices.map((service, index) => (
        <a href={`/services/${service.slug}`} class="luxe-card group relative flex min-h-[360px] flex-col p-8 md:p-9">
          <span class="absolute right-7 top-7 font-heading text-5xl leading-none text-[#b88a4a]/16">0{index + 1}</span>
          <p class="eyebrow pr-14">{service.category}</p>
          <h3 class="mt-8 font-heading text-4xl leading-[1.02] text-[#17140f] transition-colors group-hover:text-[#6f563f]">{service.name}</h3>
          <p class="mt-6 text-sm leading-7 text-[#17140f]/68">{service.description}</p>
          <p class="mt-6 text-xs font-medium leading-6 text-[#6f563f]">{bestFor[service.slug]}</p>
          <span class="mt-auto pt-9 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#b88a4a] transition-colors group-hover:text-[#17140f]">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</section>
