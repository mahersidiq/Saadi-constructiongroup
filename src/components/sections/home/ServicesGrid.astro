---
import { allServices } from '@/data/services';
---

<section class="py-24 md:py-36" style="background-color: #0F0D0A;">
  <div class="container-main px-6">

    <div class="max-w-xl mb-16">
      <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl lg:text-6xl leading-tight">
        Custom Home Builder
        <span class="block italic text-gold mt-1">Services</span>
      </h2>
      <div class="w-10 h-px bg-gold mt-8 mb-6 animate-on-scroll"></div>
      <p class="animate-on-scroll font-body text-sm text-white/40 leading-relaxed font-light">
        Every service includes plan coordination, permitting, and construction — handled by one team under one contract.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {allServices.map((service) => (
        <a
          href={`/services/${service.slug}`}
          class="animate-on-scroll group block p-8 border border-white/6 hover:border-gold/30 transition-all duration-500"
          style="background-color: #1A1714;"
        >
          <!-- Category label -->
          <p class="font-body text-[9px] tracking-[0.22em] uppercase text-gold/50 mb-6 group-hover:text-gold/70 transition-colors duration-300">
            {service.slug === 'construction-management' ? 'Management' : service.category}
          </p>

          <!-- Service name -->
          <h3 class="font-heading text-xl md:text-2xl font-light text-white/80 group-hover:text-white leading-snug mb-4 transition-colors duration-300">
            {service.name}
          </h3>

          <!-- Description -->
          <p class="font-body text-xs text-white/30 leading-relaxed font-light group-hover:text-white/45 transition-colors duration-300 mb-8">
            {service.description}
          </p>

          <!-- Arrow -->
          <div class="flex items-center gap-2 text-gold/0 group-hover:text-gold transition-all duration-400">
            <span class="w-6 h-px bg-gold"></span>
            <span class="font-body text-[10px] tracking-[0.2em] uppercase">Learn More</span>
          </div>
        </a>
      ))}
    </div>

    <div class="animate-on-scroll mt-12">
      <a href="/services" class="inline-flex items-center gap-3 font-body text-xs tracking-[0.2em] uppercase text-white/40 hover:text-gold transition-colors duration-300 group">
        <span class="w-8 h-px bg-current"></span>
        View All Services
      </a>
    </div>
  </div>
</section>
