---
import { allServices } from '@/data/services';
const bestFor = {
  'custom-home-design-build': 'Best for clients who want one builder responsible for design coordination and construction.',
  'luxury-custom-homes': 'Best for high-spec homes with detailed finishes, selections, and field control.',
  'new-home-construction': 'Best for ground-up builds on your lot across Greater Houston.',
  'home-additions-expansions': 'Best for major expansions that require structural and permit coordination.',
  'plans-permits-engineering': 'Best for turning concepts into permit-ready construction documents.',
  'construction-management': 'Best for owner-side oversight, scope discipline, and quality control.',
};
---
<section class="stone-section">
  <div class="container-main section-padding">
    <div class="mb-12 max-w-3xl animate-on-scroll">
      <p class="eyebrow">Service Pillars</p>
      <h2 class="display-heading mt-4 text-4xl md:text-6xl">Residential building services with one accountable path.</h2>
    </div>
    <div class="grid gap-px overflow-hidden border border-[rgba(71,57,40,.14)] md:grid-cols-2 lg:grid-cols-3">
      {allServices.map((service) => (
        <a href={`/services/${service.slug}`} class="group bg-[#fffaf2] p-7 transition-colors hover:bg-[#142232] md:p-9">
          <p class="eyebrow">{service.category}</p>
          <h3 class="mt-5 font-heading text-3xl leading-tight text-[#17202a] transition-colors group-hover:text-[#fff8ed]">{service.name}</h3>
          <p class="mt-5 text-sm leading-7 text-[#17202a]/70 transition-colors group-hover:text-[#fff8ed]/74">{service.description}</p>
          <p class="mt-5 text-xs font-medium leading-6 text-[#6f563f] transition-colors group-hover:text-[#e7c797]">{bestFor[service.slug]}</p>
          <span class="mt-7 inline-flex text-[11px] font-semibold uppercase tracking-[0.18em] text-[#b88a4a]">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</section>
