---
const values = [
  {
    number: '01',
    title: 'Truly One-Stop',
    text: 'Plans, engineering, permits, and construction — all under one contract. You never chase down a separate architect, engineer, or permit runner.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    number: '02',
    title: 'Owner on Every Project',
    text: "You work directly with the owner from first call to final walkthrough. No handoffs to a project manager you've never met.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />`,
  },
  {
    number: '03',
    title: 'Fixed-Price Contracts',
    text: 'We scope your project completely before we start. Your contract price is your build price — no surprise change orders mid-construction.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 00-2.25 2.25v9a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H15M9 12l2 2 4-4m-3-7v6.75M12 3l3 3m-3-3L9 6" />`,
  },
  {
    number: '04',
    title: 'Built for Houston',
    text: "Every home is designed and built for Houston's climate, soil conditions, flood zone requirements, and city permitting process.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />`,
  },
];
---

<section class="relative overflow-hidden" style="background-color: #100E0C;">
  <!-- Left side image panel -->
  <div class="absolute left-0 top-0 bottom-0 w-1/2 hidden lg:block">
    <img
      src="/images/p1-interior-living.png"
      alt="Saadi Construction Group luxury interior"
      class="w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[#100E0C]"></div>
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <div class="section-padding relative z-10">
    <div class="container-main px-6">
      <div class="lg:ml-auto lg:w-1/2 lg:pl-16">

        <!-- Section label -->
        <div class="animate-on-scroll mb-4">
          <span class="section-label">Our Commitment</span>
        </div>

        <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl leading-tight mb-3">
          Why Houston Homeowners
        </h2>
        <h2 class="animate-on-scroll font-heading font-light text-gold italic text-4xl md:text-5xl leading-tight mb-10">
          Choose Saadi
        </h2>

        <div class="space-y-10">
          {values.map((item) => (
            <div class="animate-on-scroll flex gap-8 group">
              <div class="flex-shrink-0">
                <span class="font-heading text-5xl font-light text-gold/15 group-hover:text-gold/30 transition-colors duration-500 leading-none">
                  {item.number}
                </span>
              </div>
              <div class="border-t border-gold/20 pt-4 flex-1 group-hover:border-gold/40 transition-colors duration-500">
                <h3 class="font-heading text-xl md:text-2xl font-light text-white mb-3 tracking-wide">
                  {item.title}
                </h3>
                <p class="font-body text-sm text-white/40 leading-relaxed font-light">
                  {item.text}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="animate-on-scroll mt-12">
          <a href="/about" class="btn-outline-gold">
            About Saadi Construction
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
