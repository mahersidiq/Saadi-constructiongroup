---
---

<section class="bg-cream py-24 md:py-36 overflow-hidden">
  <div class="container-main px-6">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-0 items-stretch">

      <!-- Photo column -->
      <div class="animate-on-scroll lg:col-span-5 relative">
        <div class="aspect-[4/5] lg:aspect-auto lg:h-full min-h-[480px] overflow-hidden">
          <img
            src="/images/p1-interior-living.png"
            alt="Saadi Construction Group luxury interior craftsmanship"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating gold stat anchored to photo -->
        <div class="absolute -bottom-6 -right-6 md:right-0 lg:-right-10 xl:-right-14 bg-gold p-8 text-white">
          <div class="font-heading text-5xl font-light leading-none">50<span class="text-3xl">+</span></div>
          <div class="font-body text-[10px] tracking-[0.2em] uppercase mt-1 opacity-80">Homes Built</div>
        </div>
      </div>

      <!-- Content column -->
      <div class="lg:col-span-7 lg:pl-24 xl:pl-32 flex flex-col justify-center pt-8 lg:pt-0">

        <h2 class="animate-on-scroll font-heading font-light text-warm-black leading-tight mb-10" style="font-size: clamp(2.5rem, 4.5vw, 4rem);">
          Why Houston Homeowners<br/>
          <em class="text-gold not-italic">Choose Saadi</em>
        </h2>

        <div class="space-y-0 divide-y divide-stone">
          {[
            {
              title: 'Truly One-Stop',
              body: 'Plans, engineering, permits, and construction under one contract. You never chase down a separate architect, engineer, or permit runner.',
            },
            {
              title: 'Owner on Every Project',
              body: 'You work directly with the owner from first call to final walkthrough. No handoffs to a project manager you have never met.',
            },
            {
              title: 'Fixed-Price Contracts',
              body: 'We scope your project completely before we start. Your contract price is your build price — no surprise change orders.',
            },
            {
              title: 'Built for Houston',
              body: "Every home is designed for Houston's climate, soil conditions, flood zone requirements, and city permitting process.",
            },
          ].map((item) => (
            <div class="animate-on-scroll py-7 group">
              <h3 class="font-heading text-xl font-light text-warm-black mb-2 group-hover:text-gold transition-colors duration-300">
                {item.title}
              </h3>
              <p class="font-body text-sm text-warm-mid leading-relaxed font-light">
                {item.body}
              </p>
            </div>
          ))}
        </div>

        <div class="animate-on-scroll mt-10">
          <a href="/about" class="btn-outline">About Our Approach</a>
        </div>
      </div>

    </div>
  </div>
</section>
