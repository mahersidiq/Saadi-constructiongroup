---
---

<section class="py-24 md:py-36 relative overflow-hidden" style="background-color: #13110E;">
  <div class="container-main px-6">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

      <!-- Left: Photo -->
      <div class="animate-on-scroll order-2 lg:order-1 relative">
        <div class="aspect-[3/4] overflow-hidden">
          <img
            src="/images/p1-interior-living.png"
            alt="Saadi Construction Group luxury interior craftsmanship"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating stat -->
        <div class="absolute -bottom-6 -right-4 md:right-0 lg:-right-8 p-6 md:p-8" style="background-color: #C9952A;">
          <div class="font-heading text-4xl font-light text-white leading-none">50+</div>
          <div class="font-body text-xs tracking-[0.15em] uppercase text-white/80 mt-1">Homes Built</div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="order-1 lg:order-2 lg:pt-8">
        <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl leading-tight mb-3">
          Why Houston Homeowners
        </h2>
        <h2 class="animate-on-scroll font-heading font-light text-gold italic text-4xl md:text-5xl leading-tight mb-10">
          Choose Saadi
        </h2>

        <div class="animate-on-scroll w-10 h-px bg-gold mb-10"></div>

        <div class="space-y-8">
          <div class="animate-on-scroll">
            <h3 class="font-heading text-xl font-light text-white mb-3">Truly One-Stop</h3>
            <p class="font-body text-sm text-white/45 leading-relaxed font-light">
              Plans, engineering, permits, and construction — all under one contract. You never chase down a separate architect, engineer, or permit runner.
            </p>
          </div>

          <div class="animate-on-scroll w-full h-px bg-white/6"></div>

          <div class="animate-on-scroll">
            <h3 class="font-heading text-xl font-light text-white mb-3">Owner on Every Project</h3>
            <p class="font-body text-sm text-white/45 leading-relaxed font-light">
              You work directly with the owner from first call to final walkthrough. No handoffs to a project manager you've never met.
            </p>
          </div>

          <div class="animate-on-scroll w-full h-px bg-white/6"></div>

          <div class="animate-on-scroll">
            <h3 class="font-heading text-xl font-light text-white mb-3">Fixed-Price Contracts</h3>
            <p class="font-body text-sm text-white/45 leading-relaxed font-light">
              We scope your project completely before we start. Your contract price is your build price — no surprise change orders mid-construction.
            </p>
          </div>

          <div class="animate-on-scroll w-full h-px bg-white/6"></div>

          <div class="animate-on-scroll">
            <h3 class="font-heading text-xl font-light text-white mb-3">Built for Houston</h3>
            <p class="font-body text-sm text-white/45 leading-relaxed font-light">
              Every home is designed and built for Houston's climate, soil conditions, flood zone requirements, and city permitting process.
            </p>
          </div>
        </div>

        <div class="animate-on-scroll mt-12">
          <a href="/about" class="inline-flex items-center gap-3 font-body text-xs tracking-[0.2em] uppercase text-white/40 hover:text-gold transition-colors duration-300 group">
            <span class="w-8 h-px bg-current group-hover:w-12 transition-all duration-300"></span>
            About Saadi Construction
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
