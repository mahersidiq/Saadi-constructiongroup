---
import { projects } from '@/data/projects';
const featuredProjects = [projects[7], projects[2], projects[1]];
---

<section class="bg-warm-black py-24 md:py-36 px-6">
  <div class="container-main">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
      <h2 class="animate-on-scroll font-heading font-light text-white leading-tight" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
        Featured Projects
      </h2>
      <a href="/projects" class="animate-on-scroll group inline-flex items-center gap-3 font-body text-xs tracking-[0.15em] uppercase text-white/40 hover:text-gold transition-colors duration-300">
        View All Work
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Asymmetric editorial grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3">

      <!-- Large hero project -->
      <a href="/projects" class="animate-on-scroll md:col-span-7 group block overflow-hidden">
        <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
          <img
            src={featuredProjects[0].coverImage}
            alt={featuredProjects[0].coverAlt}
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 ease-out"
            loading="lazy"
            style="transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8">
            <p class="font-body text-[10px] tracking-[0.2em] uppercase text-white/60 mb-2">{featuredProjects[0].style}</p>
            <h3 class="font-heading text-2xl md:text-3xl font-light text-white">{featuredProjects[0].title}</h3>
            <p class="font-body text-xs text-white/50 mt-1 tracking-wide">{featuredProjects[0].location} &nbsp;·&nbsp; {featuredProjects[0].sqft}</p>
          </div>
        </div>
      </a>

      <!-- Two stacked smaller projects -->
      <div class="md:col-span-5 flex flex-col gap-3">
        {featuredProjects.slice(1).map((project) => (
          <a href="/projects" class="animate-on-scroll group block overflow-hidden flex-1">
            <div class="relative overflow-hidden h-full" style="min-height: 220px;">
              <img
                src={project.coverImage}
                alt={project.coverAlt}
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 ease-out"
                loading="lazy"
                style="transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <p class="font-body text-[9px] tracking-[0.2em] uppercase text-white/60 mb-1">{project.style}</p>
                <h3 class="font-heading text-xl font-light text-white">{project.title}</h3>
                <p class="font-body text-xs text-white/50 mt-1 tracking-wide">{project.location} &nbsp;·&nbsp; {project.sqft}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile CTA -->
    <div class="animate-on-scroll mt-10 md:hidden text-center">
      <a href="/projects" class="btn-outline-light">View All Projects</a>
    </div>
  </div>
</section>
