---
import { projects } from '@/data/projects';
// Spotlight: Memorial Modernist (p8), Sugar Land Waterfront (p2), and The Woodlands Contemporary (p1)
const featured = [projects[7], projects[1], projects[0]];
---

<section class="bg-[#fbf9f5] py-28 md:py-36 border-t border-[rgba(28,25,23,0.08)]">
  <div class="container-main">
    <div class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[#8c6d46]">Curated Portfolio</p>
        <h2 class="font-heading mt-3 text-4xl sm:text-5xl md:text-6xl font-medium text-[#1c1917]">
          Residences Crafted for Houston Living.
        </h2>
        <p class="mt-4 text-base text-[#1c1917]/70">
          Each project represents an integrated design-build commission executed from preliminary soils report to final certificate of occupancy.
        </p>
      </div>
      <a 
        href="/projects" 
        class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[#8c6d46] hover:text-[#1c1917] transition-colors border-b border-[#8c6d46] pb-1 w-fit"
      >
        View Complete Works →
      </a>
    </div>

    {/* Architectural Asymmetric Bento Layout */}
    <div class="grid gap-8 lg:grid-cols-12">
      {/* Marquee Showcase: Memorial Modernist */}
      <a 
        href={`/projects/${featured[0].slug}`} 
        class="group relative block aspect-[16/11] lg:aspect-auto lg:col-span-7 overflow-hidden border border-[rgba(28,25,23,0.12)] bg-[#ebe5db] shadow-sm transition hover:shadow-lg"
      >
        <img 
          src={featured[0].coverImage} 
          alt={featured[0].coverAlt} 
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
          loading="lazy" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-8 sm:p-10 text-[#fffdf8]">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#dfc8a7]">{featured[0].style}</p>
          <h3 class="font-heading mt-2 text-3xl sm:text-4xl lg:text-5xl font-medium leading-tight text-[#fffdf8]">
            {featured[0].title}
          </h3>
          <div class="mt-3 flex items-center gap-3 text-xs font-mono text-[#dfd7ca]">
            <span>{featured[0].location}</span>
            <span aria-hidden="true">·</span>
            <span>{featured[0].sqft}</span>
            <span aria-hidden="true">·</span>
            <span>Turnkey Design-Build</span>
          </div>
        </div>
      </a>

      {/* Secondary Stack: Sugar Land & Woodlands */}
      <div class="grid gap-8 lg:col-span-5">
        {featured.slice(1).map((project) => (
          <a 
            href={`/projects/${project.slug}`} 
            class="group relative block aspect-[16/10] overflow-hidden border border-[rgba(28,25,23,0.12)] bg-[#ebe5db] shadow-sm transition hover:shadow-lg"
          >
            <img 
              src={project.coverImage} 
              alt={project.coverAlt} 
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
              loading="lazy" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 text-[#fffdf8]">
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#dfc8a7]">{project.style}</p>
              <h3 class="font-heading mt-1.5 text-2xl sm:text-3xl font-medium text-[#fffdf8]">
                {project.title}
              </h3>
              <div class="mt-2 flex items-center gap-2 text-xs font-mono text-[#dfd7ca]">
                <span>{project.location}</span>
                <span aria-hidden="true">·</span>
                <span>{project.sqft}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
