---
const items = [
  'Houston-Based & Owner-Led',
  'Plans, Permits & Construction',
  'Custom Home Specialists',
  'Licensed & Insured',
];
---

<div style="background:#0A0A0A; border-bottom: 1px solid rgba(200,155,90,0.15);">
  <div class="container-main px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-2 py-4">
      {items.map((item, i) => (
        <>
          <span class="font-body uppercase" style="font-size:10px; letter-spacing:0.2em; color:#666666; font-weight:400;">
            {item}
          </span>
          {i < items.length - 1 && (
            <span style="color:rgba(200,155,90,0.35); font-size:10px;">&middot;</span>
          )}
        </>
      ))}
    </div>
  </div>
</div>
