---
const items = [
  'Houston-Based & Owner-Led',
  'Plans, Permits & Construction',
  'Custom Home Specialists',
  'Licensed & Insured',
];
---

<div class="bg-charcoal border-y border-gold/20">
  <div class="container-main px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-4">
      {items.map((item, i) => (
        <>
          <span class="flex items-center gap-2.5">
            <span class="w-4 h-px bg-gold/60 flex-shrink-0"></span>
            <span class="font-body text-[10px] tracking-[0.2em] uppercase text-white/60 font-light">
              {item}
            </span>
          </span>
          {i < items.length - 1 && (
            <span class="hidden md:block w-px h-3 bg-gold/20 flex-shrink-0"></span>
          )}
        </>
      ))}
    </div>
  </div>
</div>
