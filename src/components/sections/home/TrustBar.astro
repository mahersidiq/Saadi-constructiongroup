---
const markers = [
  'Houston-Based & Owner-Led',
  'Integrated Design-Build Contract',
  'Memorial · River Oaks · West U',
  'Engineered Foundation Science',
  'Guaranteed Fixed-Price Scope',
];
---

<section class="border-y border-[rgba(28,25,23,0.08)] bg-[#f6f3ec]">
  <div class="container-main py-5">
    <div class="grid grid-cols-2 gap-4 text-center md:grid-cols-5 md:text-left">
      {markers.map((marker, i) => (
        <div class={`text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.2em] text-[#1c1917]/75 ${i !== 0 ? 'md:border-l md:border-[rgba(28,25,23,0.1)] md:pl-5' : ''}`}>
          {marker}
        </div>
      ))}
    </div>
  </div>
</section>
