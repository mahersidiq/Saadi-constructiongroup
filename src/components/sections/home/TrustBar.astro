---
const markers = ['Houston-Based & Owner-Led', 'Plans + Engineering + Permits + Construction', 'Licensed & Insured', 'Greater Houston Coverage', '5-Day Quote Turnaround'];
---
<section class="border-y border-[rgba(71,57,40,.14)] bg-[#fffaf2]">
  <div class="container-main py-6">
    <div class="grid gap-3 text-center md:grid-cols-5 md:text-left">
      {markers.map((marker) => <p class="relative text-[11px] font-semibold uppercase tracking-[0.2em] text-[#17140f]/78 md:border-l md:border-[rgba(184,138,74,.24)] md:pl-4">{marker}</p>)}
    </div>
  </div>
</section>
