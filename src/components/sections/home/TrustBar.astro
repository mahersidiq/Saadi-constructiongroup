---
const items = [
  'Houston-Based & Owner-Led',
  'Plans, Permits & Construction',
  'Custom Home Specialists',
  'Licensed & Insured',
];
---

<div style="background-color: #1C1915;" class="border-b border-white/5">
  <div class="container-main px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 py-3.5">
      {items.map((item, i) => (
        <>
          <span class="font-body text-[10px] tracking-[0.18em] uppercase text-white/40 font-light">
            {item}
          </span>
          {i < items.length - 1 && (
            <span class="hidden md:block text-gold/30 text-xs">&middot;</span>
          )}
        </>
      ))}
    </div>
  </div>
</div>
