---
const stats = [
  { number: '50+',   label: 'Homes Built' },
  { number: '5-Day', label: 'Quote Turnaround' },
  { number: '15+',   label: 'Years Experience' },
  { number: '100%',  label: 'Owner-Led Projects' },
];
---

<section class="grain relative" style="background:#111111;">
  <div class="gold-divider"></div>
  <div class="container-main px-6 py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-0">
      {stats.map((stat, i) => (
        <div
          class="animate-on-scroll text-center py-10 relative"
          style={`border-right: ${i < stats.length - 1 ? '1px solid rgba(200,155,90,0.15)' : 'none'}; transition-delay:${i * 0.1}s;`}
        >
          <div class="font-body font-bold leading-none mb-3"
            style="font-size:clamp(2.8rem,5.5vw,4.5rem); color:#C89B5A; letter-spacing:-0.02em;">
            {stat.number}
          </div>
          <div class="mx-auto mb-3" style="width:32px; height:1px; background:rgba(200,155,90,0.4);"></div>
          <div class="font-body uppercase" style="font-size:10px; letter-spacing:0.2em; color:#666666;">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="gold-divider"></div>
</section>
