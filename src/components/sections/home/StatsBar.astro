---
const stats = [
  { number: '50+', label: 'Homes Built' },
  { number: '5 Days', label: 'Quote Turnaround' },
  { number: '15+', label: 'Years of Experience' },
  { number: '100%', label: 'Owner-Led Projects' },
];
---

<section class="bg-cream border-y border-stone py-20 px-6">
  <div class="container-main">
    <div class="grid grid-cols-2 md:grid-cols-4">
      {stats.map((stat, i) => (
        <div class={`animate-on-scroll text-center py-8 ${i < stats.length - 1 ? 'md:border-r border-stone' : ''} ${i % 2 === 0 ? 'border-r border-stone md:border-r-0' : ''} first:border-r border-stone`}>
          <div class="font-heading text-5xl md:text-6xl font-light text-warm-black leading-none mb-3" style="letter-spacing: -0.01em;">
            {stat.number}
          </div>
          <div class="w-6 h-px bg-gold mx-auto mb-3"></div>
          <div class="font-body text-xs tracking-[0.15em] uppercase text-warm-mid font-light">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
