---
import { serviceAreas } from '@/data/serviceAreas';
---

<section class="section-padding bg-warm-black relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/10 to-transparent"></div>

  <div class="container-main px-6">

    <!-- Header -->
    <div class="text-center mb-14">
      <div class="animate-on-scroll mb-4">
        <span class="section-label">Where We Build</span>
      </div>
      <h2 class="animate-on-scroll font-heading font-light text-white text-4xl md:text-5xl leading-tight">
        Serving Houston &amp;
        <span class="italic text-gold"> Surrounding Areas</span>
      </h2>
      <div class="animate-on-scroll gold-line mt-8"></div>
      <p class="animate-on-scroll mt-6 font-body text-sm text-white/40 max-w-xl mx-auto font-light tracking-wide">
        Custom home builder serving the Greater Houston metropolitan area across Harris, Fort Bend, Montgomery, Brazoria and Galveston Counties.
      </p>
    </div>

    <!-- Areas grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
      {serviceAreas.map((area) => (
        <div class="animate-on-scroll">
          <a
            href={`/service-areas/${area.slug}`}
            class="group flex items-center gap-2.5 px-4 py-3 border border-gold/10 hover:border-gold/40 bg-dark-card hover:bg-dark-surface transition-all duration-300"
          >
            <svg class="w-3 h-3 text-gold/40 group-hover:text-gold transition-colors duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="font-body text-xs text-white/50 group-hover:text-white/80 transition-colors duration-300 truncate tracking-wide">
              {area.name}
            </span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
