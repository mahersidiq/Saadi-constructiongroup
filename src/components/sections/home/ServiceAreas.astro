---
import { serviceAreas } from '@/data/serviceAreas';
---

<section class="bg-cream py-20 md:py-28 px-6 border-t border-stone">
  <div class="container-main">
    <div class="flex flex-col md:flex-row md:items-baseline gap-6 md:gap-16 mb-12">
      <h2 class="animate-on-scroll font-heading font-light text-warm-black text-3xl md:text-4xl flex-shrink-0">
        Where We Build
      </h2>
      <p class="animate-on-scroll font-body text-sm text-warm-mid font-light leading-relaxed">
        Greater Houston metro — Harris, Fort Bend, Montgomery, Brazoria &amp; Galveston Counties.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      {serviceAreas.map((area) => (
        <a
          href={`/service-areas/${area.slug}`}
          class="animate-on-scroll font-body text-xs tracking-[0.1em] text-warm-mid hover:text-warm-black hover:bg-stone px-4 py-2.5 border border-stone hover:border-warm-black/20 transition-all duration-200"
        >
          {area.name}
        </a>
      ))}
    </div>
  </div>
</section>
