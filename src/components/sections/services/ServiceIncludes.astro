---
const { includes = [], whatIsIt = [], bestFor } = Astro.props;
---

<section class="bg-[#fbf9f5] py-20 md:py-28 border-b border-[rgba(28,25,23,0.08)]">
  <div class="container-main">
    <div class="grid gap-14 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-3">
          Scope &amp; Methodology
        </p>
        <h2 class="font-heading text-3xl md:text-5xl font-medium text-[#1c1917] leading-[1.08]">
          Engineered for serious residential decisions.
        </h2>
        <div class="mt-6 space-y-5 font-sans text-base leading-8 text-[#1c1917]/75 what-is-it">
          {whatIsIt.map((p: string) => <p>{p}</p>)}
        </div>
        {bestFor && (
          <div class="mt-8 border-l-2 border-[#8c6d46] bg-[#f6f3ec] p-6">
            <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.22em] text-[#8c6d46]">
              Ideal Project Profile
            </p>
            <p class="mt-2 font-sans text-sm leading-7 text-[#1c1917]/80">{bestFor}</p>
          </div>
        )}
      </div>

      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-5">
          Included Single-Contract Deliverables
        </p>
        <div class="grid gap-3">
          {includes.map((item: string, i: number) => (
            <div class="flex items-start gap-4 border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-5">
              <span class="font-heading text-2xl font-semibold text-[#8c6d46] tabular-nums leading-none mt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="font-sans text-sm leading-7 text-[#1c1917]/80">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
