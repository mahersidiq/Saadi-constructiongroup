---
const { includes = [], whatIsIt = [], bestFor } = Astro.props;
---
<section class="stone-section">
  <div class="container-main section-padding">
    <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div class="animate-on-scroll"><p class="eyebrow">Service Overview</p><h2 class="display-heading mt-4 text-4xl md:text-6xl">Built for serious residential decisions.</h2><div class="mt-7 space-y-5 body-large">{whatIsIt.map((p) => <p>{p}</p>)}</div>{bestFor && <div class="mt-8 border-l-2 border-[#b88a4a] bg-[#fffaf2] p-6"><p class="eyebrow">Best For</p><p class="mt-3 leading-7 text-[#17140f]/76">{bestFor}</p></div>}</div>
      <div class="animate-on-scroll"><p class="eyebrow mb-5">Included Coordination</p><div class="grid gap-3">{includes.map((item, i) => <div class="flex gap-4 border border-[rgba(71,57,40,.14)] bg-[#fffaf2]/70 p-5"><span class="font-heading text-2xl text-[#b88a4a]">{String(i + 1).padStart(2, '0')}</span><p class="leading-7 text-[#17140f]/76">{item}</p></div>)}</div></div>
    </div>
  </div>
</section>
