---
const { relatedServices = [] } = Astro.props;
---
{relatedServices.length > 0 && <section class="bg-[#fbf6ed] py-20"><div class="container-main"><p class="eyebrow text-center">Related Services</p><div class="mt-8 grid gap-4 md:grid-cols-3">{relatedServices.map((service) => <a href={`/services/${service.slug}`} class="border border-[rgba(71,57,40,.14)] bg-white/70 p-7 hover:bg-[#142232] group"><h2 class="font-heading text-3xl text-[#17202a] group-hover:text-[#fff8ed]">{service.name}</h2><span class="mt-5 inline-flex text-[11px] font-semibold uppercase tracking-[0.18em] text-[#b88a4a]">Learn more →</span></a>)}</div></div></section>}
