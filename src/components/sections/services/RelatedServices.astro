---
const { relatedServices = [] } = Astro.props;
---

{relatedServices.length > 0 && (
  <section class="bg-[#fbf9f5] py-20 border-t border-[rgba(28,25,23,0.08)]">
    <div class="container-main">
      <div class="mb-10">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
          Connected Capabilities
        </p>
        <h2 class="font-heading text-3xl md:text-4xl font-medium text-[#1c1917]">
          Complementary Design-Build Services
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {relatedServices.map((service: any) => (
          <a
            href={`/services/${service.slug}`}
            class="border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-8 transition-colors hover:border-[#8c6d46] hover:bg-white group flex flex-col justify-between"
          >
            <div>
              <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8c6d46] mb-2">
                {service.category || 'Capability'}
              </p>
              <h3 class="font-heading text-2xl md:text-3xl font-medium text-[#1c1917] group-hover:text-[#8c6d46] transition-colors">
                {service.name}
              </h3>
              {service.description && (
                <p class="mt-3 font-sans text-sm text-[#1c1917]/70 leading-relaxed">
                  {service.description}
                </p>
              )}
            </div>
            <span class="mt-6 inline-flex font-sans text-[11px] font-semibold uppercase tracking-[0.18em] text-[#8c6d46] group-hover:text-[#1c1917]">
              Explore Service →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
