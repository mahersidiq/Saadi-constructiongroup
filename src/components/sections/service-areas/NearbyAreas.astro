---
const { nearbyAreas = [] } = Astro.props;
if (!nearbyAreas || nearbyAreas.length === 0) return;
---

<section class="py-16 md:py-20 bg-[#f6f3ec] border-t border-[rgba(28,25,23,0.08)]">
  <div class="container-main">
    <div class="mb-8">
      <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
        Adjacent Jurisdictions
      </p>
      <h2 class="font-heading text-3xl font-medium text-[#1c1917]">
        Nearby Houston Enclaves We Serve
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {nearbyAreas.map((area: any) => (
        <a
          href={`/service-areas/${area.slug}`}
          class="flex items-center justify-between border border-[rgba(28,25,23,0.1)] bg-[#fbf9f5] px-5 py-4 hover:border-[#8c6d46] transition-colors group"
        >
          <span class="font-heading text-xl font-medium text-[#1c1917] group-hover:text-[#8c6d46] transition-colors">
            {area.name}
          </span>
          <span class="font-sans text-xs text-[#8c6d46]">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
