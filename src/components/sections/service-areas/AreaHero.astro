---
const { name, county, headline } = Astro.props;
---

<section class="relative min-h-[54vh] flex items-end bg-[#1c1917] text-[#fffdf8] pt-36 pb-16 overflow-hidden">
  <img
    src="/images/p3-exterior-front.png"
    alt={`Custom home architecture in ${name}, TX`}
    class="absolute inset-0 h-full w-full object-cover opacity-35"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/70 to-[#1c1917]/40"></div>
  <div class="relative z-10 container-main">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-8 bg-[#dfc8a7]"></span>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7]">
          {county ? `${county} County Jurisdiction` : 'Greater Houston Enclave'}
        </p>
      </div>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-medium text-[#fffdf8] leading-[1.05]">
        {headline || `Custom Home Builder in ${name}`}
      </h1>
      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-[#8c6d46] px-7 py-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-[#fffdf8] transition hover:bg-[#a68254]"
        >
          Schedule {name} Site Evaluation →
        </a>
      </div>
    </div>
  </div>
</section>
