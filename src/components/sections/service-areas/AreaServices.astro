---
import { serviceCategories } from '@/data/services';
const { name } = Astro.props;
---

<section class="py-20 md:py-24 bg-[#fbf9f5]">
  <div class="container-main">
    <div class="max-w-3xl mb-12">
      <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-[#8c6d46] mb-2">
        Single-Contract Capabilities
      </p>
      <h2 class="font-heading text-3xl md:text-5xl font-medium text-[#1c1917]">
        Custom Home Services Available in {name}
      </h2>
      <p class="mt-3 font-sans text-base text-[#1c1917]/75 leading-7">
        Architectural drafting, structural engineering, municipal permitting, and residential construction—managed by one team under one contract.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {serviceCategories.map((category) => (
        <div class="border border-[rgba(28,25,23,0.1)] bg-[#f6f3ec] p-7">
          <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.22em] text-[#8c6d46] mb-1">
            Division
          </p>
          <h3 class="font-heading text-2xl font-medium text-[#1c1917] pb-4 border-b border-[rgba(28,25,23,0.08)]">
            {category.name}
          </h3>
          <div class="mt-4 space-y-2.5">
            {category.services.map((service) => (
              <a
                href={`/services/${service.slug}`}
                class="flex items-center justify-between py-1.5 font-sans text-sm text-[#1c1917]/80 hover:text-[#8c6d46] transition-colors group"
              >
                <span>{service.name}</span>
                <span class="text-xs text-[#8c6d46] group-hover:translate-x-0.5 transition-transform">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
