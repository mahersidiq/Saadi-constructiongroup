---
import { serviceCategories } from '@/data/services';
import { serviceAreas } from '@/data/serviceAreas';

const designBuildServices = serviceCategories.find((c) => c.slug === 'design-build')?.services || [];
const constructionServices = serviceCategories.find((c) => c.slug === 'construction')?.services || [];
const planningServices = serviceCategories.find((c) => c.slug === 'planning-permits')?.services || [];
---

<footer class="bg-charcoal text-white relative overflow-hidden">

  <!-- Gold top accent -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/50 to-transparent"></div>

  <!-- Main footer content -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8">

      <!-- Column 1: Brand & Contact (wider) -->
      <div class="lg:col-span-2">
        <!-- Logo -->
        <a href="/" class="inline-block mb-8 group">
          <img
            src="/images/logo.svg"
            alt="Saadi Construction Group"
            class="h-16 w-auto group-hover:opacity-70 transition-opacity duration-300"
          />
        </a>

        <!-- Tagline -->
        <div class="mb-8">
          <span class="font-script text-gold text-xl" style="font-family: 'Great Vibes', cursive;">Building Vision. Creating Value.</span>
        </div>

        <p class="font-body text-xs text-white/30 mb-8 leading-relaxed tracking-wide max-w-xs">
          Houston's one-stop custom home builder. Plans, engineering, permits, and construction — all under one contract.
        </p>

        <!-- Contact details -->
        <div class="space-y-4">
          <a href="tel:8322058178" class="flex items-center gap-3 text-white/50 hover:text-gold transition-colors duration-300 group">
            <div class="w-8 h-8 flex items-center justify-center border border-gold/20 group-hover:border-gold/40 transition-colors duration-300">
              <svg class="w-3.5 h-3.5 text-gold/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <span class="font-body text-xs tracking-wide">(832) 205-8178</span>
          </a>
          <a href="mailto:info@saadiconstructiongroup.com" class="flex items-center gap-3 text-white/50 hover:text-gold transition-colors duration-300 group">
            <div class="w-8 h-8 flex items-center justify-center border border-gold/20 group-hover:border-gold/40 transition-colors duration-300">
              <svg class="w-3.5 h-3.5 text-gold/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <span class="font-body text-xs tracking-wide">info@saadiconstructiongroup.com</span>
          </a>
          <div class="flex items-start gap-3 text-white/30">
            <div class="w-8 h-8 flex items-center justify-center border border-gold/10 flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <span class="font-body text-xs tracking-wide leading-relaxed">801 Travis St Suite 2101<br/>Houston, TX 77002</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Design & Build -->
      <div>
        <h4 class="font-body text-[9px] font-semibold uppercase tracking-[0.25em] text-gold/70 mb-6 pb-3 border-b border-gold/15">
          Design &amp; Build
        </h4>
        <ul class="space-y-3">
          {designBuildServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Construction -->
      <div>
        <h4 class="font-body text-[9px] font-semibold uppercase tracking-[0.25em] text-gold/70 mb-6 pb-3 border-b border-gold/15">
          Construction
        </h4>
        <ul class="space-y-3">
          {constructionServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">
                {s.name}
              </a>
            </li>
          ))}
        </ul>

        <h4 class="font-body text-[9px] font-semibold uppercase tracking-[0.25em] text-gold/70 mt-8 mb-6 pb-3 border-b border-gold/15">
          Planning &amp; Permits
        </h4>
        <ul class="space-y-3">
          {planningServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Service Areas + Quick Links -->
      <div>
        <h4 class="font-body text-[9px] font-semibold uppercase tracking-[0.25em] text-gold/70 mb-6 pb-3 border-b border-gold/15">
          Service Areas
        </h4>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 mb-8">
          {serviceAreas.map((area) => (
            <li>
              <a href={`/service-areas/${area.slug}`} class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">
                {area.name}
              </a>
            </li>
          ))}
        </ul>

        <h4 class="font-body text-[9px] font-semibold uppercase tracking-[0.25em] text-gold/70 mb-6 pb-3 border-b border-gold/15">
          Quick Links
        </h4>
        <ul class="space-y-3">
          <li><a href="/about" class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">About</a></li>
          <li><a href="/projects" class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">Projects</a></li>
          <li><a href="/blog" class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">Blog</a></li>
          <li><a href="/contact" class="font-body text-xs text-white/40 hover:text-white/80 transition-colors duration-300 tracking-wide">Contact</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gold/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="font-body text-[10px] text-white/20 tracking-wide leading-relaxed">
          General Contractor &nbsp;·&nbsp; Licensed &amp; Insured &nbsp;·&nbsp; Houston, Texas &nbsp;·&nbsp; Harris, Fort Bend, Montgomery, Brazoria &amp; Galveston Counties
        </p>
        <p class="font-body text-[10px] text-white/20 tracking-wide">
          &copy; 2026 Saadi Construction Group
        </p>
      </div>
    </div>
  </div>
</footer>
