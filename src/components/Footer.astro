---
import { serviceCategories } from '@/data/services';
import { serviceAreas } from '@/data/serviceAreas';
const designBuildServices = serviceCategories.find((cat) => cat.slug === 'design-build')?.services || [];
const constructionServices = serviceCategories.find((cat) => cat.slug === 'construction')?.services || [];
const planningServices = serviceCategories.find((cat) => cat.slug === 'planning-permits')?.services || [];
---

<footer class="border-t border-[rgba(255,253,248,0.1)] bg-[#1c1917] text-[#fffdf8]">
  <div class="container-main py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr_0.85fr_1fr]">
      <div>
        <a href="/" class="group inline-flex items-center gap-3" aria-label="Saadi Construction Group home">
          <img
            src="/images/Emblem.png"
            alt="SCG Emblem"
            loading="lazy"
            class="h-11 w-11 shrink-0 object-contain opacity-95 transition-transform duration-300 group-hover:scale-105"
          />
          <span class="flex flex-col border-l border-[#dfc8a7]/30 pl-3 leading-none text-[#fffdf8]">
            <span class="font-heading text-2xl font-semibold uppercase tracking-[0.2em]">Saadi</span>
            <span class="mt-1 font-sans text-[9px] font-semibold uppercase tracking-[0.24em] text-[#dfc8a7]">Construction Group</span>
          </span>
        </a>
        <p class="mt-6 max-w-xs font-sans text-sm leading-7 text-[#dfd7ca]/75">
          Houston’s single-contract custom home design-build practice. Architectural drafting, structural engineering, city permitting, and master residential construction.
        </p>
        <div class="mt-6 space-y-2 font-sans text-sm text-[#dfd7ca]/85">
          <a href="tel:+18323603804" class="block hover:text-[#dfc8a7] tabular-nums">(832) 360-3804</a>
          <a href="mailto:info@saadiconstructiongroup.com" class="block break-all hover:text-[#dfc8a7]">info@saadiconstructiongroup.com</a>
          <p class="text-[#dfd7ca]/65">801 Travis St Suite 2101<br />Houston, TX 77002</p>
        </div>
      </div>

      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#dfc8a7] mb-5">Design &amp; Build</p>
        <ul class="space-y-2.5">
          {designBuildServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-sans text-sm text-[#dfd7ca]/75 hover:text-[#dfc8a7] transition-colors">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#dfc8a7] mb-5">Construction</p>
        <ul class="space-y-2.5 mb-8">
          {constructionServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-sans text-sm text-[#dfd7ca]/75 hover:text-[#dfc8a7] transition-colors">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#dfc8a7] mb-5">Planning &amp; Permits</p>
        <ul class="space-y-2.5">
          {planningServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="font-sans text-sm text-[#dfd7ca]/75 hover:text-[#dfc8a7] transition-colors">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-[#dfc8a7] mb-5">Houston Enclaves</p>
        <ul class="grid grid-cols-2 gap-2">
          {serviceAreas.slice(0, 12).map((area) => (
            <li>
              <a href={`/service-areas/${area.slug}`} class="font-sans text-sm text-[#dfd7ca]/75 hover:text-[#dfc8a7] transition-colors">
                {area.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8 pt-6 border-t border-[rgba(255,253,248,0.08)] flex flex-wrap gap-5 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-[#dfd7ca]/80">
          <a href="/services" class="hover:text-[#dfc8a7]">Services</a>
          <a href="/projects" class="hover:text-[#dfc8a7]">Portfolio</a>
          <a href="/service-areas" class="hover:text-[#dfc8a7]">Areas</a>
          <a href="/blog" class="hover:text-[#dfc8a7]">Guides</a>
          <a href="/tools" class="hover:text-[#dfc8a7]">Tools</a>
          <a href="/about" class="hover:text-[#dfc8a7]">About</a>
          <a href="/contact" class="hover:text-[#dfc8a7]">Contact</a>
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-[rgba(255,253,248,0.08)] bg-[#141210]">
    <div class="container-main flex flex-col gap-3 py-5 font-sans text-xs text-[#dfd7ca]/60 md:flex-row md:items-center md:justify-between">
      <p>Licensed &amp; Insured · Houston, TX · Harris, Fort Bend &amp; Montgomery Counties</p>
      <p>&copy; 2026 Saadi Construction Group · saadiconstructiongroup.com</p>
    </div>
  </div>
</footer>
