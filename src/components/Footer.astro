---
import { serviceCategories } from '@/data/services';
import { serviceAreas } from '@/data/serviceAreas';

const designBuildServices = serviceCategories.find((c) => c.slug === 'design-build')?.services || [];
const constructionServices = serviceCategories.find((c) => c.slug === 'construction')?.services || [];
const planningServices = serviceCategories.find((c) => c.slug === 'planning-permits')?.services || [];
---

<footer style="background-color: #1C1915;" class="text-white">

  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-8 group">
          <img
            src="/images/logo.svg"
            alt="Saadi Construction Group"
            class="h-16 w-auto group-hover:opacity-70 transition-opacity duration-300"
          />
        </a>

        <div class="mb-8">
          <span class="font-script text-gold text-2xl" style="font-family: 'Great Vibes', cursive;">Building Vision. Creating Value.</span>
        </div>

        <p class="font-body text-xs text-white/30 mb-8 leading-relaxed font-light max-w-xs">
          Houston's one-stop custom home builder. Plans, engineering, permits, and construction — all under one contract.
        </p>

        <div class="space-y-3">
          <a href="tel:8322058178" class="flex items-center gap-3 text-white/40 hover:text-gold transition-colors duration-300 font-body text-xs tracking-wide">
            (832) 205-8178
          </a>
          <a href="mailto:info@saadiconstructiongroup.com" class="flex items-center gap-3 text-white/40 hover:text-gold transition-colors duration-300 font-body text-xs tracking-wide">
            info@saadiconstructiongroup.com
          </a>
          <p class="font-body text-xs text-white/25 tracking-wide leading-relaxed">
            801 Travis St Suite 2101<br/>Houston, TX 77002
          </p>
        </div>
      </div>

      <!-- Services columns -->
      <div>
        <h4 class="font-body text-[9px] font-bold uppercase tracking-[0.22em] text-white/30 mb-5">Design &amp; Build</h4>
        <ul class="space-y-3">
          {designBuildServices.map((s) => (
            <li><a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200 tracking-wide">{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-body text-[9px] font-bold uppercase tracking-[0.22em] text-white/30 mb-5">Construction</h4>
        <ul class="space-y-3 mb-8">
          {constructionServices.map((s) => (
            <li><a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200 tracking-wide">{s.name}</a></li>
          ))}
        </ul>
        <h4 class="font-body text-[9px] font-bold uppercase tracking-[0.22em] text-white/30 mb-5">Planning &amp; Permits</h4>
        <ul class="space-y-3">
          {planningServices.map((s) => (
            <li><a href={`/services/${s.slug}`} class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200 tracking-wide">{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-body text-[9px] font-bold uppercase tracking-[0.22em] text-white/30 mb-5">Service Areas</h4>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 mb-8">
          {serviceAreas.map((area) => (
            <li><a href={`/service-areas/${area.slug}`} class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200 tracking-wide">{area.name}</a></li>
          ))}
        </ul>
        <h4 class="font-body text-[9px] font-bold uppercase tracking-[0.22em] text-white/30 mb-5">Company</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200">About</a></li>
          <li><a href="/projects" class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200">Projects</a></li>
          <li><a href="/contact" class="font-body text-xs text-white/40 hover:text-white transition-colors duration-200">Contact</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/6">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="font-body text-[10px] text-white/15 tracking-wide">
        Licensed &amp; Insured &nbsp;·&nbsp; Houston, TX &nbsp;·&nbsp; Harris, Fort Bend, Montgomery, Brazoria &amp; Galveston Counties
      </p>
      <p class="font-body text-[10px] text-white/15">&copy; 2026 Saadi Construction Group</p>
    </div>
  </div>
</footer>
